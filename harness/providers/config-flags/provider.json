{
  "schema": 1,
  "id": "config-flags",
  "name": "Config-file flags",
  "description": "Read flag state from a repository configuration file and store unapplied flag proposals; never toggle flags.",
  "capabilities": ["flags"],
  "access": {
    "native": true
  },
  "operations": {
    "flags.read-state": {
      "tool": "wholeloop.config-flags.read-state",
      "args": {
        "file": "wholeloop.flags.json"
      },
      "guidance": "guidance/rollout.md"
    },
    "flags.propose-change": {
      "tool": "wholeloop.flags.propose-change",
      "args": {
        "apply": false,
        "proposalOnly": true
      },
      "guidance": "guidance/rollout.md"
    }
  },
  "degrade": {
    "flags.read-state": "open-question",
    "flags.propose-change": "handoff-artifact"
  }
}
