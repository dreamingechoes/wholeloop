{
  "schema": 1,
  "id": "local-tracker",
  "name": "Local tracker",
  "description": "Track work items in the external local store.",
  "capabilities": ["tracker"],
  "access": {
    "local": true
  },
  "operations": {
    "tracker.create-item": {
      "tool": "wholeloop.local-tracker.create-item"
    },
    "tracker.read-item": {
      "tool": "wholeloop.local-tracker.read-item"
    },
    "tracker.update-item": {
      "tool": "wholeloop.local-tracker.update-item"
    },
    "tracker.link-items": {
      "tool": "wholeloop.local-tracker.link-items"
    },
    "tracker.transition": {
      "tool": "wholeloop.local-tracker.transition"
    }
  },
  "degrade": {
    "tracker.create-item": "handoff-artifact",
    "tracker.read-item": "handoff-artifact",
    "tracker.update-item": "handoff-artifact",
    "tracker.link-items": "handoff-artifact",
    "tracker.transition": "handoff-artifact"
  }
}
