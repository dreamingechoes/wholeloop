{
  "schema": 1,
  "id": "sentry",
  "name": "Sentry",
  "description": "Retrieve read-only evidence from Sentry.",
  "access": {
    "mcp": {
      "server": "sentry",
      "install": {
        "transport": "http",
        "url": "https://mcp.sentry.dev/mcp",
        "auth": "oauth"
      }
    }
  },
  "capabilities": ["source.errors"],
  "operations": {
    "source.errors.query": {
      "tool": "search_events",
      "args": {},
      "guidance": "guidance/query.md"
    }
  },
  "degrade": {
    "source.errors.query": "open-question"
  }
}
