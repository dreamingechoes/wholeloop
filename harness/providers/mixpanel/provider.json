{
  "schema": 1,
  "id": "mixpanel",
  "name": "Mixpanel",
  "description": "Retrieve read-only evidence from Mixpanel.",
  "access": {
    "mcp": {
      "server": "mixpanel",
      "install": {
        "transport": "http",
        "url": "https://mcp.mixpanel.com/mcp",
        "auth": "oauth"
      }
    },
    "native": true
  },
  "capabilities": ["source.product-analytics", "dashboards"],
  "operations": {
    "source.product-analytics.query": {
      "tool": "Run-Query",
      "args": {},
      "guidance": "guidance/query.md"
    },
    "dashboards.create": {
      "tool": "wholeloop.dashboard.handoff",
      "guidance": "guidance/rollout.md"
    }
  },
  "degrade": {
    "source.product-analytics.query": "open-question",
    "dashboards.create": "handoff-artifact"
  }
}
