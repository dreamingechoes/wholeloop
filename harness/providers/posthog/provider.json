{
  "schema": 1,
  "id": "posthog",
  "name": "PostHog",
  "description": "Retrieve read-only evidence from PostHog.",
  "access": {
    "mcp": {
      "server": "posthog",
      "install": {
        "transport": "http",
        "url": "https://mcp.posthog.com/mcp?mode=tools",
        "auth": "oauth"
      }
    },
    "native": true
  },
  "capabilities": ["source.product-analytics", "dashboards", "flags"],
  "operations": {
    "source.product-analytics.query": {
      "tool": "execute-sql",
      "args": {
        "query": "{{query}}"
      },
      "guidance": "guidance/query.md"
    },
    "dashboards.create": {
      "tool": "wholeloop.dashboard.handoff",
      "guidance": "guidance/rollout.md"
    },
    "flags.read-state": {
      "tool": "wholeloop.flags.read-state",
      "args": {
        "service": "posthog"
      },
      "guidance": "guidance/rollout.md"
    },
    "flags.propose-change": {
      "tool": "wholeloop.flags.propose-change",
      "args": {
        "apply": false,
        "proposalOnly": true
      },
      "guidance": "guidance/rollout.md"
    }
  },
  "degrade": {
    "source.product-analytics.query": "open-question",
    "dashboards.create": "handoff-artifact",
    "flags.read-state": "open-question",
    "flags.propose-change": "handoff-artifact"
  }
}
