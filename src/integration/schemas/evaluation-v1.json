{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wholeloop/integration-evaluation@1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "controller", "scope", "checks", "retainedFixture", "reason"],
  "properties": {
    "schema": {
      "const": "wholeloop/integration-evaluation@1",
      "type": "string"
    },
    "status": {
      "enum": ["passed", "failed"],
      "type": "string"
    },
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "architecture", "node", "git"],
      "properties": {
        "os": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "architecture": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "node": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "git": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "checks": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "evidence"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "evidence": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "retainedFixture": {
      "type": "string",
      "maxLength": 4096
    },
    "reason": {
      "type": "string",
      "maxLength": 1048576
    }
  }
}
