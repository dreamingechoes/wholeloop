{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wholeloop/integration-candidate@1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "const": "wholeloop/integration-candidate@1"
    },
    "run": {
      "type": "string",
      "pattern": "^delivery-[a-f0-9]{16}$",
      "maxLength": 25
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "plan": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "maxLength": 64
    },
    "milestone": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "maxLength": 64
    },
    "strategy": {
      "type": "string",
      "const": "ordered-merge"
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "work": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "maxLength": 64
          },
          "repository": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "maxLength": 64
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "ref": {
            "type": "string",
            "pattern": "^refs/heads/[A-Za-z0-9][A-Za-z0-9/_.-]*$",
            "maxLength": 256
          },
          "head": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$",
            "maxLength": 40
          },
          "snapshot": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "maxLength": 64
          }
        },
        "required": ["work", "repository", "path", "ref", "head", "snapshot"]
      }
    },
    "assemblies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "repository": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "maxLength": 64
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "ref": {
            "type": "string",
            "pattern": "^refs/heads/[A-Za-z0-9][A-Za-z0-9/_.-]*$",
            "maxLength": 256
          },
          "base": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$",
            "maxLength": 40
          },
          "head": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$",
            "maxLength": 40
          },
          "snapshot": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "maxLength": 64
          },
          "parents": {
            "type": "array",
            "maxItems": 256,
            "items": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$",
              "maxLength": 40
            }
          }
        },
        "required": ["repository", "path", "ref", "base", "head", "snapshot", "parents"]
      }
    },
    "contracts": {
      "type": "array",
      "minItems": 0,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "maxLength": 64
          },
          "revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "maxLength": 64
          }
        },
        "required": ["id", "revision", "sha256"]
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "maxLength": 64
          },
          "kind": {
            "type": "string",
            "enum": ["acceptance", "recipe", "data", "gate-policy"]
          },
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "maxLength": 64
          },
          "after": {
            "type": "array",
            "minItems": 0,
            "maxItems": 256,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$",
              "maxLength": 64
            }
          },
          "repository": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "maxLength": 64
          },
          "gate": {
            "type": "string",
            "enum": ["verify", "review"]
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8388608
          }
        },
        "required": ["id", "kind", "ref", "sha256", "after", "bytes"]
      }
    },
    "repairOwners": {
      "type": "array",
      "minItems": 0,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "criterion": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "maxLength": 64
          },
          "kind": {
            "type": "string",
            "enum": ["work", "integration"]
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "maxLength": 64
          }
        },
        "required": ["criterion", "kind", "id"]
      }
    },
    "source": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "maxLength": 64
    },
    "inputIdentity": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "maxLength": 64
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "milestones": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "maxLength": 64
          }
        },
        "work": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "repository", "role", "criteria", "after", "consumes", "produces"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,127}$"
              },
              "repository": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$",
                "maxLength": 64
              },
              "role": {
                "type": "string",
                "enum": ["contract", "implementation", "research"]
              },
              "criteria": {
                "type": "array",
                "minItems": 0,
                "maxItems": 1000,
                "items": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
                }
              },
              "after": {
                "type": "array",
                "minItems": 0,
                "maxItems": 100,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{0,127}$"
                }
              },
              "consumes": {
                "type": "array",
                "minItems": 0,
                "maxItems": 100,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{0,127}$"
                }
              },
              "produces": {
                "type": "array",
                "minItems": 0,
                "maxItems": 100,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "revision", "sha256", "description"],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_-]{0,127}$"
                    },
                    "revision": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096
                    }
                  }
                }
              }
            }
          }
        },
        "waves": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$",
              "maxLength": 64
            }
          }
        },
        "criteria": {
          "type": "array",
          "minItems": 0,
          "maxItems": 256,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "maxLength": 64
          }
        },
        "procedure": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": ["milestones", "work", "waves", "criteria", "procedure"]
    },
    "guidance": {
      "type": "array",
      "minItems": 0,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slot", "ref", "sha256"],
        "properties": {
          "slot": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "repository": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,127}$"
          }
        }
      }
    },
    "execution": {
      "type": "string",
      "const": "not-performed"
    },
    "acceptance": {
      "type": "string",
      "const": "not-established"
    },
    "publication": {
      "type": "string",
      "const": "not-performed"
    }
  },
  "required": [
    "schema",
    "run",
    "revision",
    "plan",
    "milestone",
    "strategy",
    "parts",
    "assemblies",
    "contracts",
    "inputs",
    "repairOwners",
    "source",
    "inputIdentity",
    "dependencies",
    "guidance",
    "execution",
    "acceptance",
    "publication"
  ]
}
