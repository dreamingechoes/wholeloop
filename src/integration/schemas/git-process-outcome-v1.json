{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wholeloop/integration-operation-outcome@1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "const": "wholeloop/integration-operation-outcome@1"
    },
    "operation": {
      "type": "string",
      "maxLength": 55,
      "pattern": "^assembly-operation-[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$"
    },
    "nonce": {
      "type": "string",
      "maxLength": 36,
      "pattern": "^[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$"
    },
    "pid": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "code": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "signal": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^SIG[A-Z0-9]+$"
    },
    "reason": {
      "type": "string",
      "enum": ["finished", "cancelled", "timeout", "not-started", "launch-failed"]
    },
    "at": {
      "type": "string",
      "maxLength": 64
    }
  },
  "required": ["schema", "operation", "nonce", "pid", "reason", "at"]
}
