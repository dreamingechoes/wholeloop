{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wholeloop/integration-assembly-status@1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "const": "wholeloop/integration-assembly-status@1"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "maxLength": 64
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "type": "string",
          "const": "wholeloop/integration-assembly-record@1"
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "maxLength": 64
        },
        "assembly": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema": {
              "type": "string",
              "const": "wholeloop/integration-assembly@1"
            },
            "request": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "run": {
                  "type": "string",
                  "pattern": "^delivery-[a-f0-9]{16}$",
                  "maxLength": 25
                },
                "revision": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000
                },
                "plan": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$",
                  "maxLength": 64
                },
                "milestone": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{0,63}$",
                  "maxLength": 64
                },
                "parts": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 256,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "work": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_-]{0,63}$",
                        "maxLength": 64
                      },
                      "repository": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_-]{0,63}$",
                        "maxLength": 64
                      },
                      "path": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096
                      },
                      "ref": {
                        "type": "string",
                        "pattern": "^refs/heads/[A-Za-z0-9][A-Za-z0-9/_.-]*$",
                        "maxLength": 256
                      },
                      "head": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{40}$",
                        "maxLength": 40
                      }
                    },
                    "required": ["work", "repository", "path", "ref", "head"]
                  }
                },
                "schema": {
                  "type": "string",
                  "const": "wholeloop/integration-assembly-request@1"
                },
                "key": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{0,31}$",
                  "maxLength": 32
                },
                "repairOf": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$",
                  "maxLength": 64
                }
              },
              "required": ["schema", "run", "revision", "plan", "milestone", "parts", "key"]
            },
            "source": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$",
              "maxLength": 64
            },
            "grant": {
              "type": "string",
              "pattern": "^authorization-[a-f0-9]{16}$"
            },
            "grantDigest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$",
              "maxLength": 64
            },
            "parts": {
              "type": "array",
              "minItems": 1,
              "maxItems": 256,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "work": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_-]{0,63}$",
                    "maxLength": 64
                  },
                  "repository": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_-]{0,63}$",
                    "maxLength": 64
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "ref": {
                    "type": "string",
                    "pattern": "^refs/heads/[A-Za-z0-9][A-Za-z0-9/_.-]*$",
                    "maxLength": 256
                  },
                  "head": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{40}$",
                    "maxLength": 40
                  },
                  "snapshot": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$",
                    "maxLength": 64
                  }
                },
                "required": ["work", "repository", "path", "ref", "head", "snapshot"]
              }
            },
            "repositories": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "repository": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_-]{0,63}$",
                    "maxLength": 64
                  },
                  "root": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "commonDir": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "target": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "base": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{40}$"
                  },
                  "branch": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "parts": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 256,
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
                      "maxLength": 64
                    }
                  }
                },
                "required": [
                  "repository",
                  "root",
                  "commonDir",
                  "target",
                  "base",
                  "branch",
                  "path",
                  "parts"
                ]
              }
            }
          },
          "required": [
            "schema",
            "request",
            "source",
            "grant",
            "grantDigest",
            "parts",
            "repositories"
          ]
        }
      },
      "required": ["schema", "digest", "assembly"]
    },
    "status": {
      "type": "string",
      "enum": ["not-run", "assembled", "conflict", "failed", "partial", "unknown", "stale"]
    },
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "repository": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "status": {
            "type": "string",
            "enum": ["not-run", "assembled", "conflict", "failed", "unknown", "stale"]
          },
          "head": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$",
            "maxLength": 40
          },
          "effects": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^effect-[a-f0-9]{32}$"
            },
            "maxItems": 256
          }
        },
        "required": ["repository", "path", "ref", "status", "effects"]
      },
      "maxItems": 16
    },
    "repair": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "const": "integration"
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "criteria": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "maxItems": 1000
        },
        "basis": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "maxLength": 64
        }
      },
      "required": ["kind", "owner", "criteria", "basis"]
    },
    "acceptance": {
      "type": "string",
      "const": "not-established"
    },
    "publication": {
      "type": "string",
      "const": "not-performed"
    },
    "rollback": {
      "type": "string",
      "const": "not-performed"
    }
  },
  "required": [
    "schema",
    "digest",
    "record",
    "status",
    "repositories",
    "acceptance",
    "publication",
    "rollback"
  ]
}
