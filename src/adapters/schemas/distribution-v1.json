{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wholeloop/distribution-artifacts@1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "const": "wholeloop/distribution-artifacts@1"
    },
    "target": {
      "type": "string",
      "const": "distribution"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "core": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "type": "integer",
            "enum": [420, 493]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": ["path", "mode", "sha256"]
      }
    },
    "publication": {
      "type": "string",
      "const": "not-performed"
    },
    "conformance": {
      "type": "string",
      "const": "unverified"
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "target": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "manifest": {
            "type": "string",
            "minLength": 1
          },
          "skills": {
            "type": "integer",
            "minimum": 1
          },
          "agents": {
            "type": "integer",
            "minimum": 1
          },
          "nativeManifest": {
            "type": "string",
            "minLength": 1
          },
          "capabilities": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "conformance": {
                "type": "string",
                "const": "unverified"
              },
              "skills": {
                "type": "string",
                "const": "rendered"
              },
              "agents": {
                "type": "string",
                "const": "rendered"
              },
              "hooks": {
                "type": "string",
                "enum": ["native-and-git-fallback", "git-fallback"]
              },
              "readOnly": {
                "type": "string",
                "enum": [
                  "tool-allowlist-and-plan-mode",
                  "inherited-parent-and-checked-headless",
                  "deny-shell-and-edit",
                  "read-tool-allowlist",
                  "native-readonly"
                ]
              },
              "engines": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "enum": ["headless", "sequential"]
                }
              }
            },
            "required": ["conformance", "skills", "agents", "hooks", "readOnly", "engines"]
          }
        },
        "required": [
          "target",
          "path",
          "manifest",
          "skills",
          "agents",
          "nativeManifest",
          "capabilities"
        ]
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema",
    "target",
    "version",
    "source",
    "core",
    "files",
    "publication",
    "conformance",
    "targets",
    "limitations"
  ]
}
