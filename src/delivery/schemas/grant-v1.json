{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wholeloop/delivery-grant@1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "operator",
    "basis",
    "expiresAt",
    "effects",
    "decisions",
    "repositories",
    "reads",
    "effectLimit",
    "requestDigest",
    "issuedAt",
    "source",
    "owner",
    "policy",
    "budgets",
    "provenance"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "wholeloop/delivery-grant@1"
    },
    "id": {
      "type": "string",
      "pattern": "^authorization-[a-f0-9]{16}$"
    },
    "operator": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "digest"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["plan", "envelope"]
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "run": {
          "type": "string",
          "pattern": "^delivery-[a-f0-9]{16}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      }
    },
    "expiresAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
    },
    "effects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 11,
      "items": {
        "type": "string",
        "enum": [
          "source.read",
          "report.write",
          "workspace.create",
          "code.write",
          "test.run",
          "git.commit",
          "git.push",
          "pr.create",
          "pr.update",
          "pr.ready",
          "pr.merge"
        ]
      }
    },
    "decisions": {
      "type": "array",
      "minItems": 0,
      "maxItems": 10,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "repositories": {
      "type": "array",
      "minItems": 0,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository", "topicPrefix"],
        "properties": {
          "repository": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,127}$"
          },
          "topicPrefix": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "remote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    },
    "reads": {
      "type": "array",
      "minItems": 0,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "scope", "operations"],
        "properties": {
          "provider": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "scope": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "operations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        }
      }
    },
    "effectLimit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "requestDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "issuedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
    },
    "source": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint", "intervention", "uncertainty", "delegations"],
      "properties": {
        "endpoint": {
          "type": "string",
          "enum": ["research-report", "local-handoff", "to-pr", "to-merge"]
        },
        "intervention": {
          "type": "string",
          "enum": ["supervised", "on-exception", "none"]
        },
        "uncertainty": {
          "type": "string",
          "enum": [
            "investigate",
            "explicit-default",
            "least-scope",
            "complete-with-unknowns",
            "on-hold",
            "blocked"
          ]
        },
        "delegations": {
          "type": "array",
          "minItems": 0,
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "rubric", "evidence", "fallback"],
            "properties": {
              "id": {
                "type": "string",
                "enum": [
                  "delivery-plan",
                  "research-plan",
                  "research-sources",
                  "frame-outcome",
                  "approve-spec",
                  "approve-scopes",
                  "approve-build-plan",
                  "acceptance",
                  "learning-outcome",
                  "ramp-assessment"
                ]
              },
              "rubric": {
                "type": "object",
                "additionalProperties": false,
                "required": ["ref", "sha256"],
                "properties": {
                  "ref": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "maxItems": 100,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                }
              },
              "fallback": {
                "type": "string",
                "enum": [
                  "investigate",
                  "explicit-default",
                  "least-scope",
                  "complete-with-unknowns",
                  "on-hold",
                  "blocked"
                ]
              }
            }
          }
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wallTimeMs",
        "attemptMs",
        "artifactBytes",
        "builders",
        "buildersPerRepository",
        "evaluators",
        "noProgress",
        "restarts",
        "ciPushes",
        "integrationRepairs"
      ],
      "properties": {
        "wallTimeMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "attemptMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "artifactBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "builders": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "buildersPerRepository": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "evaluators": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "noProgress": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "restarts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "ciPushes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "integrationRepairs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "provenance": {
      "type": "string",
      "const": "operator-control"
    }
  }
}
