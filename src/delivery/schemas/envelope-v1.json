{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wholeloop/delivery-envelope@1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source",
    "owner",
    "scope",
    "repositories",
    "guidance",
    "policy",
    "budgets",
    "capabilities",
    "limits"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "wholeloop/delivery-envelope@1"
    },
    "source": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcomes", "exclusions"],
      "properties": {
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "text"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,127}$"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            }
          }
        },
        "exclusions": {
          "type": "array",
          "minItems": 0,
          "maxItems": 1000,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        }
      }
    },
    "repositories": {
      "type": "array",
      "minItems": 0,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "root", "target", "base"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,127}$"
          },
          "root": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "base": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}(?:[a-f0-9]{24})?$"
          },
          "remote": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "url"],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
              },
              "url": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            }
          }
        }
      }
    },
    "guidance": {
      "type": "array",
      "minItems": 0,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slot", "ref", "sha256"],
        "properties": {
          "slot": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "repository": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,127}$"
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint", "intervention", "uncertainty", "delegations"],
      "properties": {
        "endpoint": {
          "type": "string",
          "enum": ["research-report", "local-handoff", "to-pr", "to-merge"]
        },
        "intervention": {
          "type": "string",
          "enum": ["supervised", "on-exception", "none"]
        },
        "uncertainty": {
          "type": "string",
          "enum": [
            "investigate",
            "explicit-default",
            "least-scope",
            "complete-with-unknowns",
            "on-hold",
            "blocked"
          ]
        },
        "delegations": {
          "type": "array",
          "minItems": 0,
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "rubric", "evidence", "fallback"],
            "properties": {
              "id": {
                "type": "string",
                "enum": [
                  "delivery-plan",
                  "research-plan",
                  "research-sources",
                  "frame-outcome",
                  "approve-spec",
                  "approve-scopes",
                  "approve-build-plan",
                  "acceptance",
                  "learning-outcome",
                  "ramp-assessment"
                ]
              },
              "rubric": {
                "type": "object",
                "additionalProperties": false,
                "required": ["ref", "sha256"],
                "properties": {
                  "ref": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "maxItems": 100,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                }
              },
              "fallback": {
                "type": "string",
                "enum": [
                  "investigate",
                  "explicit-default",
                  "least-scope",
                  "complete-with-unknowns",
                  "on-hold",
                  "blocked"
                ]
              }
            }
          }
        },
        "merge": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "checks", "denylist", "exceptions"],
          "properties": {
            "method": {
              "type": "string",
              "enum": ["merge", "squash", "rebase"]
            },
            "checks": {
              "type": "object",
              "additionalProperties": false,
              "required": ["required"],
              "properties": {
                "required": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 100,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["name", "issuer"],
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      },
                      "issuer": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      }
                    }
                  }
                }
              }
            },
            "denylist": {
              "type": "array",
              "maxItems": 200,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            },
            "exceptions": {
              "type": "array",
              "maxItems": 200,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            }
          }
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wallTimeMs",
        "attemptMs",
        "artifactBytes",
        "builders",
        "buildersPerRepository",
        "evaluators",
        "noProgress",
        "restarts",
        "ciPushes",
        "integrationRepairs"
      ],
      "properties": {
        "wallTimeMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "attemptMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "artifactBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "builders": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "buildersPerRepository": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "evaluators": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "noProgress": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "restarts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "ciPushes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "integrationRepairs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 0,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "client", "version", "host", "status", "evidence"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,127}$"
          },
          "client": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "host": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "status": {
            "type": "string",
            "enum": ["observed", "unavailable", "unverified"]
          },
          "evidence": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work", "criteria", "revisions"],
      "properties": {
        "work": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "criteria": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "revisions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      }
    }
  }
}
