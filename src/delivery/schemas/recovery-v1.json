{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wholeloop/delivery-recovery@1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "records"],
  "properties": {
    "schema": {
      "type": "string",
      "const": "wholeloop/delivery-recovery@1"
    },
    "records": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "basis",
          "assignment",
          "attempt",
          "generation",
          "status",
          "owned",
          "evidence",
          "provenance",
          "reason",
          "sequence"
        ],
        "properties": {
          "basis": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "assignment": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "attempt": {
            "type": "string",
            "pattern": "^attempt-[a-f0-9]{16}$"
          },
          "generation": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "status": {
            "type": "string",
            "enum": ["running", "stopped", "not-started", "unknown"]
          },
          "runtime": {
            "type": "object",
            "additionalProperties": false,
            "required": ["backend", "instance", "worker"],
            "properties": {
              "backend": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "instance": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "worker": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          },
          "owned": {
            "type": "boolean"
          },
          "evidence": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "provenance": {
            "type": "string",
            "enum": ["fixture", "host-observed", "controller-observed"]
          },
          "reason": {
            "type": "string",
            "enum": ["observed", "unavailable-host", "identity-mismatch", "unconfirmed-stop"]
          },
          "sequence": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
