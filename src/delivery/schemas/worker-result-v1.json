{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wholeloop/delivery-worker-result@1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "assignment",
    "identity",
    "status",
    "origin",
    "summary",
    "artifacts",
    "criteria",
    "findings",
    "unknowns"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "wholeloop/delivery-worker-result@1"
    },
    "assignment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run", "plan", "revision", "role", "attempt", "generation"],
      "properties": {
        "run": {
          "type": "string",
          "minLength": 1,
          "maxLength": 25,
          "pattern": "^delivery-[a-f0-9]{16}$"
        },
        "plan": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "role": {
          "type": "string",
          "enum": [
            "builder",
            "verifier",
            "reviewer",
            "refuter",
            "researcher",
            "planner",
            "challenger"
          ]
        },
        "attempt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24,
          "pattern": "^attempt-[a-f0-9]{16}$"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9_-]{0,127}$"
        },
        "cell": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "status": {
      "type": "string",
      "enum": ["complete", "blocked", "unavailable", "failed"]
    },
    "origin": {
      "type": "string",
      "const": "worker-claim"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "sha256", "bytes", "kind"],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^artifacts/[a-zA-Z0-9][a-zA-Z0-9._/-]{0,4085}$"
          },
          "sha256": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1048576
          },
          "kind": {
            "type": "string",
            "enum": ["plan", "patch", "report", "evidence"]
          }
        }
      },
      "minItems": 0,
      "maxItems": 100,
      "uniqueItems": true
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "evidence"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9_-]{0,127}$"
          },
          "status": {
            "type": "string",
            "enum": ["pass", "fail", "unavailable"]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^artifacts/[a-zA-Z0-9][a-zA-Z0-9._/-]{0,4085}$"
            },
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true
          }
        }
      },
      "minItems": 0,
      "maxItems": 1000,
      "uniqueItems": true
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "evidence"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9_-]{0,127}$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^artifacts/[a-zA-Z0-9][a-zA-Z0-9._/-]{0,4085}$"
            },
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true
          },
          "criterion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9_-]{0,127}$"
          }
        }
      },
      "minItems": 0,
      "maxItems": 1000,
      "uniqueItems": true
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "reason", "owner"],
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "owner": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      },
      "minItems": 0,
      "maxItems": 100,
      "uniqueItems": true
    }
  }
}
