{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wholeloop/delivery-source-observation@1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "provider", "scope", "status", "ref", "complete", "attachments"],
  "properties": {
    "schema": {
      "type": "string",
      "const": "wholeloop/delivery-source-observation@1"
    },
    "provider": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "status": {
      "type": "string",
      "enum": ["succeeded", "pending"]
    },
    "ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "complete": {
      "type": "boolean"
    },
    "body": {
      "type": "string",
      "minLength": 0,
      "maxLength": 1048576
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "attachments": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "sha256"],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
