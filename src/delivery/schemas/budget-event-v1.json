{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wholeloop/delivery-budget-event@1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "basis", "action"],
  "properties": {
    "schema": {
      "type": "string",
      "const": "wholeloop/delivery-budget-event@1"
    },
    "basis": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "action": {
      "type": "string",
      "enum": [
        "configured",
        "started",
        "clock",
        "limits",
        "reserved",
        "usage",
        "counter",
        "failure",
        "progress",
        "artifact-reserved",
        "artifact-observed",
        "artifact-omitted"
      ]
    },
    "grantDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "tokens": {
          "type": "object",
          "additionalProperties": false,
          "required": ["limit", "mode"],
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "mode": {
              "type": "string",
              "enum": ["hard", "advisory"]
            }
          }
        },
        "currency": {
          "type": "object",
          "additionalProperties": false,
          "required": ["currency", "micros", "mode"],
          "properties": {
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "micros": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "mode": {
              "type": "string",
              "enum": ["hard", "advisory"]
            }
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wallTimeMs",
        "attemptMs",
        "artifactBytes",
        "builders",
        "buildersPerRepository",
        "evaluators",
        "noProgress",
        "restarts",
        "ciPushes",
        "integrationRepairs"
      ],
      "properties": {
        "wallTimeMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "attemptMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "artifactBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "builders": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "buildersPerRepository": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "evaluators": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "noProgress": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "restarts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "ciPushes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "integrationRepairs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall", "monotonicMs", "epoch"],
      "properties": {
        "wall": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
        },
        "monotonicMs": {
          "type": "number",
          "minimum": 0
        },
        "epoch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "startedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
    },
    "deadline": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
    },
    "reservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "deadline", "clock"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(?:attempt|invocation)-[a-f0-9]{16}$"
        },
        "kind": {
          "type": "string",
          "enum": ["attempt", "effect"]
        },
        "unit": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,127}$"
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "deadline": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
        },
        "metering": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hardTokens", "hardCurrency", "meter", "evidence", "provenance"],
          "properties": {
            "tokensMaximum": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "currencyMaximum": {
              "type": "object",
              "additionalProperties": false,
              "required": ["currency", "micros"],
              "properties": {
                "currency": {
                  "type": "string",
                  "pattern": "^[A-Z]{3}$"
                },
                "micros": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              }
            },
            "hardTokens": {
              "type": "boolean"
            },
            "hardCurrency": {
              "type": "boolean"
            },
            "meter": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,127}$"
            },
            "evidence": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "provenance": {
              "type": "string",
              "enum": ["fixture", "host-observed"]
            }
          }
        },
        "cell": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "clock": {
          "type": "object",
          "additionalProperties": false,
          "required": ["wall", "monotonicMs", "epoch"],
          "properties": {
            "wall": {
              "type": "string",
              "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
            },
            "monotonicMs": {
              "type": "number",
              "minimum": 0
            },
            "epoch": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "reservation", "meter", "mode", "evidence", "provenance", "final"],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,127}$"
        },
        "reservation": {
          "type": "string",
          "pattern": "^(?:attempt|invocation)-[a-f0-9]{16}$"
        },
        "meter": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,127}$"
        },
        "mode": {
          "type": "string",
          "enum": ["delta", "cumulative"]
        },
        "tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "currency": {
          "type": "object",
          "additionalProperties": false,
          "required": ["currency", "micros"],
          "properties": {
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "micros": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "evidence": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "provenance": {
          "type": "string",
          "enum": ["fixture", "host-observed"]
        },
        "final": {
          "type": "boolean"
        }
      }
    },
    "counter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "kind", "evidence", "provenance"],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,127}$"
        },
        "kind": {
          "type": "string",
          "enum": ["integration-repair"]
        },
        "evidence": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "provenance": {
          "type": "string",
          "enum": ["fixture", "host-observed"]
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "role", "category", "candidate", "findings", "evidence", "provenance"],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,127}$"
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "category": {
          "type": "string",
          "enum": [
            "missing-input",
            "policy",
            "denied-access",
            "unavailable-model",
            "transient-provider",
            "invalid-output",
            "failed-behavior",
            "stale-evidence",
            "conflict",
            "ambiguous-effect",
            "capacity",
            "deadline",
            "no-progress"
          ]
        },
        "candidate": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "findings": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "evidence": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "provenance": {
          "type": "string",
          "enum": ["fixture", "host-observed"]
        }
      }
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "kind", "digest", "evidence", "provenance"],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,127}$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "validated-artifact",
            "observed-behavior",
            "resolved-finding",
            "accepted-candidate",
            "reconciled-effect"
          ]
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "evidence": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "provenance": {
          "type": "string",
          "enum": ["fixture", "host-observed"]
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "bytes", "ref"],
      "properties": {
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "ref": {
          "type": "string",
          "pattern": "^delivery/artifacts/delivery-[a-f0-9]{16}/[a-f0-9]{64}$"
        }
      }
    },
    "reason": {
      "type": "string",
      "enum": ["artifact-byte-limit", "credential-bearing"]
    }
  }
}
