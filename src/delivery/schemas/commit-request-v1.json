{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "wholeloop/delivery-commit-request@1",
  "required": ["schema", "workspace", "key", "head", "snapshot", "message"],
  "properties": {
    "schema": {
      "type": "string",
      "const": "wholeloop/delivery-commit-request@1"
    },
    "workspace": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "maxLength": 64
    },
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "maxLength": 64
    },
    "head": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}(?:[a-f0-9]{24})?$",
      "maxLength": 64
    },
    "snapshot": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "maxLength": 64
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    }
  }
}
