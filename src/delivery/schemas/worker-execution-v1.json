{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wholeloop/delivery-worker-execution@1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "assignment",
    "identity",
    "runtime",
    "status",
    "stdout",
    "stderr",
    "startedAt",
    "finishedAt",
    "provenance",
    "origin",
    "acceptance"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "wholeloop/delivery-worker-execution@1"
    },
    "assignment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run", "plan", "revision", "role", "attempt", "generation"],
      "properties": {
        "run": {
          "type": "string",
          "minLength": 1,
          "maxLength": 25,
          "pattern": "^delivery-[a-f0-9]{16}$"
        },
        "plan": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "role": {
          "type": "string",
          "enum": [
            "builder",
            "verifier",
            "reviewer",
            "refuter",
            "researcher",
            "planner",
            "challenger"
          ]
        },
        "attempt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24,
          "pattern": "^attempt-[a-f0-9]{16}$"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9_-]{0,127}$"
        },
        "cell": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "instance", "worker"],
      "properties": {
        "backend": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "instance": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "worker": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "succeeded",
        "failed",
        "timed-out",
        "cancelled",
        "invalid-output",
        "changed",
        "stale"
      ]
    },
    "code": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "stdout": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "stderr": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "result": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "startedAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 24
    },
    "finishedAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 24
    },
    "provenance": {
      "type": "string",
      "enum": ["fixture", "host-observed"]
    },
    "origin": {
      "type": "string",
      "const": "controller-observation"
    },
    "acceptance": {
      "type": "string",
      "const": "not-established"
    }
  }
}
