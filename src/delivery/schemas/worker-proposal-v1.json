{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wholeloop/delivery-worker-proposal@1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "assignment",
    "status",
    "summary",
    "criteria",
    "findings",
    "unknowns",
    "artifacts"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "wholeloop/delivery-worker-proposal@1"
    },
    "assignment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "type": "string",
      "enum": ["complete", "blocked", "unavailable", "failed"]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "evidence"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9_-]{0,127}$"
          },
          "status": {
            "type": "string",
            "enum": ["pass", "fail", "unavailable"]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^artifacts/[a-zA-Z0-9][a-zA-Z0-9._/-]{0,4085}$"
            },
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true
          }
        }
      },
      "minItems": 0,
      "maxItems": 1000,
      "uniqueItems": true
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "evidence"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9_-]{0,127}$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^artifacts/[a-zA-Z0-9][a-zA-Z0-9._/-]{0,4085}$"
            },
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true
          },
          "criterion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9_-]{0,127}$"
          }
        }
      },
      "minItems": 0,
      "maxItems": 1000,
      "uniqueItems": true
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "reason", "owner"],
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "owner": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      },
      "minItems": 0,
      "maxItems": 100,
      "uniqueItems": true
    },
    "artifacts": {
      "type": "array",
      "minItems": 0,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "kind", "text"],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^artifacts/[a-zA-Z0-9][a-zA-Z0-9._/-]{0,4085}$"
          },
          "kind": {
            "type": "string",
            "enum": ["plan", "patch", "report", "evidence"]
          },
          "text": {
            "type": "string",
            "minLength": 0,
            "maxLength": 262144
          }
        }
      }
    }
  }
}
