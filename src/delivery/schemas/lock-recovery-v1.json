{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wholeloop/delivery-lock-recovery@1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "owner", "digest", "retained", "reason"],
  "properties": {
    "schema": {
      "type": "string",
      "const": "wholeloop/delivery-lock-recovery@1"
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pid", "started"],
      "properties": {
        "pid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "started": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
        }
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "retained": {
      "type": "string",
      "pattern": "^delivery/recovered-locks/[a-f0-9-]{36}$"
    },
    "reason": {
      "type": "string",
      "const": "Observed ESRCH for this exact retained writer record."
    }
  }
}
