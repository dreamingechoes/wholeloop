{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wholeloop/delivery-authorization-request@1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "operator",
    "basis",
    "effects",
    "decisions",
    "repositories",
    "reads",
    "effectLimit"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "wholeloop/delivery-authorization-request@1"
    },
    "id": {
      "type": "string",
      "pattern": "^authorization-[a-f0-9]{16}$"
    },
    "operator": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "digest"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["plan", "envelope"]
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "run": {
          "type": "string",
          "pattern": "^delivery-[a-f0-9]{16}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      }
    },
    "expiresAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
    },
    "effects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 11,
      "items": {
        "type": "string",
        "enum": [
          "source.read",
          "report.write",
          "workspace.create",
          "code.write",
          "test.run",
          "git.commit",
          "git.push",
          "pr.create",
          "pr.update",
          "pr.ready",
          "pr.merge"
        ]
      }
    },
    "decisions": {
      "type": "array",
      "minItems": 0,
      "maxItems": 10,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "repositories": {
      "type": "array",
      "minItems": 0,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository", "topicPrefix"],
        "properties": {
          "repository": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,127}$"
          },
          "topicPrefix": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "remote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    },
    "reads": {
      "type": "array",
      "minItems": 0,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "scope", "operations"],
        "properties": {
          "provider": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "scope": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "operations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        }
      }
    },
    "effectLimit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    }
  }
}
