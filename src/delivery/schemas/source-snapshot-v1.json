{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wholeloop/delivery-source-snapshot@1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "kind",
    "ref",
    "provider",
    "scope",
    "revision",
    "sha256",
    "fetchedAt",
    "origin",
    "body",
    "mapping",
    "attachments"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "wholeloop/delivery-source-snapshot@1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "type": "string",
      "enum": ["inline", "file", "item", "tracker", "document"]
    },
    "ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "provider": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "fetchedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
    },
    "origin": {
      "type": "string",
      "enum": ["local", "import", "host"]
    },
    "body": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1048576
    },
    "mapping": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "startLine", "endLine"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
          },
          "role": {
            "type": "string",
            "enum": ["criterion", "context"]
          },
          "startLine": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1048576
          },
          "endLine": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1048576
          }
        }
      }
    },
    "attachments": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "sha256"],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
