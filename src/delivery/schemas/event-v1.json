{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wholeloop/delivery-event@1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "sequence", "ts", "run", "actor", "payload", "digest"],
  "properties": {
    "schema": {
      "type": "string",
      "const": "wholeloop/delivery-event@1"
    },
    "id": {
      "type": "string",
      "pattern": "^delivery-event-[a-f0-9-]{36}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "ts": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
    },
    "run": {
      "type": "string",
      "pattern": "^delivery-[a-f0-9]{16}$"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["operator", "controller"]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "channel": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        }
      },
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name"],
          "properties": {
            "kind": {
              "const": "operator"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "channel": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name"],
          "properties": {
            "kind": {
              "const": "controller"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        }
      ]
    },
    "previous": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "payload": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schema"],
      "properties": {
        "schema": {
          "type": "string",
          "pattern": "^wholeloop/delivery-[a-z][a-z0-9-]*@[1-9][0-9]*$"
        }
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "description": "Private decision reason; at most 4096 UTF-8 bytes. Not an approval or authority."
    }
  },
  "$comment": "ADR-0210: optional attribution added before the v1 freeze; absent fields remain unknown. UTF-8 byte limits and decision ownership are additionally enforced by the core.",
  "allOf": [
    {
      "if": {
        "required": ["rationale"]
      },
      "then": {
        "oneOf": [
          {
            "properties": {
              "actor": {
                "properties": {
                  "kind": {
                    "const": "operator"
                  }
                }
              },
              "payload": {
                "properties": {
                  "schema": {
                    "const": "wholeloop/delivery-control-event@1"
                  }
                }
              }
            }
          },
          {
            "properties": {
              "actor": {
                "properties": {
                  "kind": {
                    "const": "controller"
                  }
                }
              },
              "payload": {
                "properties": {
                  "schema": {
                    "const": "wholeloop/delivery-runner-event@1"
                  },
                  "action": {
                    "const": "observed"
                  },
                  "stage": {
                    "type": "string",
                    "pattern": "^(plan|acceptance|build-plan:.+)$"
                  }
                },
                "required": ["schema", "action", "stage"]
              }
            }
          }
        ]
      }
    }
  ]
}
