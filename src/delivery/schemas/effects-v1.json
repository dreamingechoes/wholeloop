{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wholeloop/delivery-effects@1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "records"],
  "properties": {
    "schema": {
      "type": "string",
      "const": "wholeloop/delivery-effects@1"
    },
    "records": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["intent", "digest", "status", "sequence", "observations"],
        "properties": {
          "intent": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "schema",
              "id",
              "key",
              "run",
              "basis",
              "grant",
              "grantDigest",
              "operation",
              "ref",
              "inputDigest"
            ],
            "properties": {
              "schema": {
                "type": "string",
                "const": "wholeloop/delivery-effect-intent@1"
              },
              "id": {
                "type": "string",
                "pattern": "^effect-[a-f0-9]{32}$"
              },
              "key": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,127}$"
              },
              "run": {
                "type": "string",
                "pattern": "^delivery-[a-f0-9]{16}$"
              },
              "basis": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "grant": {
                "type": "string",
                "pattern": "^authorization-[a-f0-9]{16}$"
              },
              "grantDigest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "operation": {
                "type": "string",
                "enum": [
                  "workspace.create",
                  "code.write",
                  "test.run",
                  "git.commit",
                  "git.push",
                  "pr.create",
                  "pr.update",
                  "pr.ready",
                  "pr.merge",
                  "report.write"
                ]
              },
              "repository": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,127}$"
              },
              "ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "expectedHead": {
                "type": "string",
                "pattern": "^[a-f0-9]{40}(?:[a-f0-9]{24})?$"
              },
              "inputDigest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "attempt": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "generation"],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^attempt-[a-f0-9]{16}$"
                  },
                  "generation": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  }
                }
              }
            }
          },
          "digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "status": {
            "type": "string",
            "enum": ["prepared", "pending", "applied", "not-applied", "unknown", "abandoned"]
          },
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "invocation": {
            "type": "string",
            "pattern": "^invocation-[a-f0-9]{16}$"
          },
          "observations": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "binding",
                "status",
                "evidence",
                "provenance",
                "reason",
                "invocationState"
              ],
              "properties": {
                "binding": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "status": {
                  "type": "string",
                  "enum": ["applied", "not-applied", "unknown"]
                },
                "evidence": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "provenance": {
                  "type": "string",
                  "enum": ["fixture", "host-observed", "controller-observed"]
                },
                "resource": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["ref", "revision"],
                  "properties": {
                    "ref": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096
                    },
                    "revision": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512
                    }
                  }
                },
                "reason": {
                  "type": "string",
                  "enum": [
                    "observed",
                    "lost-response",
                    "binding-mismatch",
                    "unavailable-read",
                    "transient-provider",
                    "denied-access",
                    "invalid-output",
                    "clock-invalid",
                    "deadline"
                  ]
                },
                "invocationState": {
                  "type": "string",
                  "enum": ["stopped", "running", "unknown"]
                }
              }
            }
          },
          "admission": {
            "type": "object",
            "additionalProperties": false,
            "required": ["evidence", "provenance"],
            "properties": {
              "evidence": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "provenance": {
                "type": "string",
                "enum": ["fixture", "host-observed"]
              }
            }
          },
          "deadline": {
            "type": "string",
            "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
          }
        }
      }
    }
  }
}
