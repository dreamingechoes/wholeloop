{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wholeloop/delivery-source-request@1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "ref", "mapping"],
  "properties": {
    "schema": {
      "type": "string",
      "const": "wholeloop/delivery-source-request@1"
    },
    "kind": {
      "type": "string",
      "enum": ["inline", "file", "item", "tracker", "document"]
    },
    "ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "mapping": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "startLine", "endLine"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
          },
          "role": {
            "type": "string",
            "enum": ["criterion", "context"]
          },
          "startLine": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1048576
          },
          "endLine": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1048576
          }
        }
      }
    },
    "body": {
      "type": "string",
      "minLength": 0,
      "maxLength": 1048576
    },
    "provider": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "provider", "scope", "status", "ref", "complete", "attachments"],
      "properties": {
        "schema": {
          "type": "string",
          "const": "wholeloop/delivery-source-observation@1"
        },
        "provider": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "status": {
          "type": "string",
          "enum": ["succeeded", "pending"]
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "complete": {
          "type": "boolean"
        },
        "body": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1048576
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "attachments": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ref", "sha256"],
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    }
  }
}
