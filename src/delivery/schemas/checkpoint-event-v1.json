{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wholeloop/delivery-checkpoint-event@1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "basis", "key", "stage", "manifest"],
  "properties": {
    "schema": {
      "type": "string",
      "const": "wholeloop/delivery-checkpoint-event@1"
    },
    "basis": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,127}$"
    },
    "stage": {
      "type": "string",
      "enum": [
        "source-adopted",
        "plan-accepted",
        "environment-ready",
        "builder-plan",
        "implementation-committed",
        "gate-sealed",
        "integrated-candidate",
        "publication-observed",
        "ci-observed",
        "merge-observed"
      ]
    },
    "manifest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "generation"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^attempt-[a-f0-9]{16}$"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    }
  }
}
