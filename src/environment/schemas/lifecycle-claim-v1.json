{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wholeloop/environment-lifecycle-claim@1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "const": "wholeloop/environment-lifecycle-claim@1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$"
    },
    "environment": {
      "type": "string",
      "pattern": "^environment-[a-f0-9]{32}$",
      "maxLength": 44
    },
    "request": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "maxLength": 64
    },
    "pid": {
      "type": "integer",
      "minimum": 1
    },
    "at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    }
  },
  "required": ["schema", "id", "environment", "request", "pid", "at"]
}
