{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wholeloop/environment-runtime@1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "const": "wholeloop/environment-runtime@1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 44,
      "pattern": "^environment-[a-f0-9]{32}$"
    },
    "run": {
      "type": "string",
      "minLength": 1,
      "maxLength": 25,
      "pattern": "^delivery-[a-f0-9]{16}$"
    },
    "basis": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "recipe": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "grant": {
      "type": "string",
      "minLength": 1,
      "maxLength": 30,
      "pattern": "^authorization-[a-f0-9]{16}$"
    },
    "grantDigest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "effect": {
      "type": "string",
      "minLength": 1,
      "maxLength": 39,
      "pattern": "^effect-[a-f0-9]{32}$"
    },
    "invocation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 27,
      "pattern": "^invocation-[a-f0-9]{16}$"
    },
    "createdAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "deadline": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "state": {
      "type": "string",
      "enum": [
        "planned",
        "provisioning",
        "ready",
        "failed",
        "unavailable",
        "unknown",
        "stopped",
        "retired",
        "retained"
      ]
    },
    "provenance": {
      "type": "string",
      "enum": ["fixture", "host-observed"]
    },
    "helperImage": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[a-z0-9][a-z0-9./:_-]*@sha256:[a-f0-9]{64}$"
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "os": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "architecture": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": ["os", "architecture"]
    },
    "daemon": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "os": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "architecture": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "cpus": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "memoryBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": ["id", "version", "os", "architecture", "cpus", "memoryBytes"]
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "repository": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "head": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-f0-9]{40}(?:[a-f0-9]{24})?$"
          },
          "snapshot": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-f0-9]{64}$"
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": ["repository", "path", "head", "snapshot", "content"]
      },
      "minItems": 0,
      "maxItems": 32
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["container", "volume", "network"]
          },
          "slot": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"
          },
          "token": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "status": {
            "type": "string",
            "enum": ["intent", "observed", "started", "exited", "stopped", "retired", "unknown"]
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "service": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "purpose": {
            "type": "string",
            "enum": [
              "workspace",
              "data",
              "input",
              "service",
              "setup",
              "seed",
              "test",
              "readiness",
              "initialize",
              "network",
              "ingress",
              "proxy"
            ]
          },
          "exit": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "ports": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "container": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "host": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              },
              "required": ["container", "host"]
            },
            "minItems": 0,
            "maxItems": 32
          },
          "policy": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "stamp": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": ["kind", "slot", "name", "token", "status", "purpose"]
      },
      "minItems": 0,
      "maxItems": 512
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "stage": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "at": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "status": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-f0-9]{64}$"
          },
          "resource": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": ["stage", "at", "status", "evidence"]
      },
      "minItems": 0,
      "maxItems": 512
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_-]{0,127}$"
    },
    "acceptance": {
      "type": "string",
      "const": "not-established"
    },
    "publication": {
      "type": "string",
      "const": "not-performed"
    },
    "lifetimeDeadline": {
      "type": "string",
      "maxLength": 64
    }
  },
  "required": [
    "schema",
    "id",
    "run",
    "basis",
    "recipe",
    "key",
    "grant",
    "grantDigest",
    "token",
    "effect",
    "createdAt",
    "deadline",
    "state",
    "provenance",
    "helperImage",
    "host",
    "candidates",
    "resources",
    "observations",
    "acceptance",
    "publication",
    "lifetimeDeadline"
  ]
}
