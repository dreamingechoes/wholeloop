{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wholeloop/environment-exec-release@1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "environment",
    "operation",
    "nonce",
    "resource",
    "pid",
    "at",
    "evidence",
    "provenance"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "wholeloop/environment-exec-release@1"
    },
    "environment": {
      "type": "string",
      "pattern": "^environment-[a-f0-9]{32}$",
      "maxLength": 44
    },
    "operation": {
      "type": "string",
      "pattern": "^operation-[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$",
      "maxLength": 46
    },
    "nonce": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$",
      "maxLength": 36
    },
    "resource": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "maxLength": 64
    },
    "pid": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "at": {
      "type": "string",
      "maxLength": 64
    },
    "evidence": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "maxLength": 64
    },
    "provenance": {
      "type": "string",
      "enum": ["fixture", "host-observed"]
    }
  }
}
