{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wholeloop/environment-operation@1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "const": "wholeloop/environment-operation@1"
    },
    "id": {
      "type": "string",
      "maxLength": 46,
      "pattern": "^operation-[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$"
    },
    "environment": {
      "type": "string",
      "maxLength": 44,
      "pattern": "^environment-[a-f0-9]{32}$"
    },
    "nonce": {
      "type": "string",
      "maxLength": 36,
      "pattern": "^[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$"
    },
    "action": {
      "type": "string",
      "enum": ["create", "start", "stop", "remove", "pull"]
    },
    "command": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "at": {
      "type": "string",
      "maxLength": 64
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600000
    },
    "provenance": {
      "type": "string",
      "enum": ["fixture", "host-observed"]
    }
  },
  "required": [
    "schema",
    "id",
    "environment",
    "nonce",
    "action",
    "command",
    "at",
    "timeoutMs",
    "provenance"
  ]
}
