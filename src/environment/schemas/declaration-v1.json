{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wholeloop/environment-declaration@1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "key": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "resource": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "effect": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "by": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "undo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cwd": {
          "type": "string",
          "minLength": 1,
          "pattern": "^/"
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["cwd", "argv"]
    }
  },
  "required": ["key", "resource", "effect", "by", "undo"]
}
