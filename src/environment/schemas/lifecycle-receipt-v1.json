{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wholeloop/environment-lifecycle-receipt@1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "const": "wholeloop/environment-lifecycle-receipt@1"
    },
    "request": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "maxLength": 64
    },
    "environment": {
      "type": "string",
      "pattern": "^environment-[a-f0-9]{32}$",
      "maxLength": 44
    },
    "action": {
      "type": "string",
      "enum": ["stop", "reconcile", "retire"]
    },
    "state": {
      "type": "string",
      "enum": ["stopped", "retained", "retired", "unknown"]
    },
    "runtime": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "maxLength": 64
    },
    "at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "provenance": {
      "type": "string",
      "enum": ["fixture", "host-observed"]
    },
    "clients": {
      "type": "string",
      "enum": ["stopped", "unknown"]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "reviewAfter": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "acceptance": {
      "type": "string",
      "const": "not-established"
    },
    "publication": {
      "type": "string",
      "const": "not-performed"
    }
  },
  "required": [
    "schema",
    "request",
    "environment",
    "action",
    "state",
    "runtime",
    "at",
    "provenance",
    "clients",
    "reason",
    "reviewAfter",
    "acceptance",
    "publication"
  ]
}
