{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wholeloop/environment-provision-request@1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "const": "wholeloop/environment-provision-request@1"
    },
    "run": {
      "type": "string",
      "maxLength": 25,
      "pattern": "^delivery-[a-f0-9]{16}$"
    },
    "recipe": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "key": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "helperImage": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^[a-z0-9][a-z0-9./:_-]*@sha256:[a-f0-9]{64}$"
    },
    "workspaces": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "repository": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "path": {
            "type": "string",
            "maxLength": 4096,
            "pattern": "^/"
          },
          "head": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-f0-9]{40}(?:[a-f0-9]{24})?$"
          },
          "snapshot": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": ["repository", "path", "head", "snapshot"]
      }
    }
  },
  "required": ["schema", "run", "recipe", "key", "helperImage", "workspaces"]
}
