{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wholeloop/environment-lifecycle-release@1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "const": "wholeloop/environment-lifecycle-release@1"
    },
    "claim": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$"
    },
    "at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    }
  },
  "required": ["schema", "claim", "at"]
}
