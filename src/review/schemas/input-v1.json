{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wholeloop/review-input@1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "run": {
      "type": "string",
      "pattern": "^gate-[a-f0-9]{16}$"
    },
    "round": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "before": {
      "type": "string",
      "pattern": "^[a-f0-9]{40,64}$"
    },
    "after": {
      "type": "string",
      "pattern": "^[a-f0-9]{40,64}$"
    },
    "objects": {
      "type": "string",
      "pattern": "^review/objects/[a-f0-9]{16}$"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "exists": {
            "type": "boolean"
          },
          "mode": {
            "type": "string",
            "enum": ["100644", "100755", "120000"]
          },
          "oid": {
            "type": "string",
            "pattern": "^[a-f0-9]{40,64}$"
          }
        },
        "required": ["path", "exists"]
      }
    },
    "diffDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "rubric": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "origin": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": ["ref", "origin", "digest"]
    }
  },
  "required": ["run", "round", "before", "after", "objects", "files", "diffDigest", "rubric"]
}
