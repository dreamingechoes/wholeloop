{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wholeloop/conformance-collection@1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "entries"],
  "properties": {
    "schema": { "type": "string", "const": "wholeloop/conformance-collection@1" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cli", "channel", "pin"],
        "properties": {
          "cli": {
            "type": "string",
            "enum": ["claude", "codex", "opencode", "copilot", "gemini", "antigravity", "cursor"]
          },
          "channel": { "type": "string", "enum": ["pinned", "latest"] },
          "pin": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[A-Za-z0-9.-]+)?$" }
        }
      }
    }
  }
}
