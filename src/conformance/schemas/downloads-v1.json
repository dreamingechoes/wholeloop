{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wholeloop/conformance-downloads@1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "platform", "arch", "entries"],
  "properties": {
    "schema": {
      "const": "wholeloop/conformance-downloads@1",
      "type": "string"
    },
    "platform": {
      "enum": ["darwin", "linux"],
      "type": "string"
    },
    "arch": {
      "enum": ["arm64", "x64"],
      "type": "string"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cli", "channel", "version", "url", "integrity"],
        "properties": {
          "cli": {
            "enum": ["claude", "codex", "opencode", "copilot", "gemini", "antigravity", "cursor"],
            "type": "string"
          },
          "channel": {
            "enum": ["pinned", "latest"],
            "type": "string"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[A-Za-z0-9.-]+)?$"
          },
          "url": {
            "type": "string"
          },
          "integrity": {
            "type": "string"
          }
        }
      }
    }
  }
}
