{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wholeloop/gate-vote@1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "finding": {
      "type": "string",
      "pattern": "^[^:]+:[^:]+$"
    },
    "verifier": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9
    },
    "outcome": {
      "type": "string",
      "enum": ["refute", "confirm", "uncertain"]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    }
  },
  "required": ["finding", "verifier", "outcome", "reason", "evidence"]
}
