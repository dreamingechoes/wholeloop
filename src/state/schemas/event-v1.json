                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "goal": {
                  "type": "string",
                  "minLength": 1
                },
                "metrics": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_-]*$"
                  },
                  "minItems": 0,
                  "uniqueItems": true
                },
                "stories": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_-]*$"
                  },
                  "minItems": 0,
                  "uniqueItems": true
                },
                "measurementReason": {
                  "type": "string",
                  "minLength": 1
                },
                "delivery": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "mode": {
                      "type": "string",
