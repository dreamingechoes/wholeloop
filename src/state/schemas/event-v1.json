                "ref": {
                  "type": "string",
                  "minLength": 1
                },
                "handoff": {
                  "type": "string"
                }
              },
              "required": ["provider", "operation", "status", "ref"]
            }
          },
          "required": ["initiative", "run", "definition", "after", "tracker"]
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "slice.defined"
        },
        "subject": {
          "type": "string",
          "pattern": "^slice-[a-f0-9]{8}$"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "scope": {
              "type": "string",
              "pattern": "^scope-[a-f0-9]{8}$"
            },
            "run": {
              "type": "string",
              "pattern": "^run-[a-f0-9]{16}$"
            },
            "definition": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "$id": "wholeloop/slice-definition@1",
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "key": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]*$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "objective": {
                  "type": "string",
                  "minLength": 1
