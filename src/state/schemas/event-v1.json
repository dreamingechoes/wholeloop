{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wholeloop/state-event@1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "v": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^ev-[a-f0-9-]{36}$"
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": ["person", "agent", "system"]
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["kind", "name"]
    },
    "subject": {
      "type": "string",
      "pattern": "^(init|scope|slice|part|brief|review)-[a-f0-9]{8}$"
    },
    "type": {
      "type": "string"
    },
    "data": {
      "type": "object"
    }
  },
  "required": ["v", "id", "ts", "actor", "subject", "type", "data"],
  "oneOf": [
    {
      "properties": {
        "type": {
          "const": "item.created"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": ["initiative", "scope", "slice", "part", "brief", "review"]
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "owner": {
              "type": "string",
              "minLength": 1
            },
            "body": {
              "type": "string"
            },
            "parent": {
              "type": "string",
              "pattern": "^(init|scope|slice|part|brief|review)-[a-f0-9]{8}$"
            }
          },
          "required": ["kind", "title", "owner", "body"]
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "item.updated"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "owner": {
              "type": "string",
              "minLength": 1
            },
            "body": {
              "type": "string"
            },
            "status": {
              "enum": ["open", "closed"]
            }
          },
          "required": [],
          "minProperties": 1
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "item.closed"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {},
          "required": []
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "note.added"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["text"]
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "link.added"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^https?://"
            }
          },
          "required": ["url"]
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "msg.sent"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "to": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:_.-]{0,127}$"
            },
            "from": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:_.-]{0,127}$"
            },
            "kind": {
              "enum": ["contract", "handoff", "status", "question", "note"]
            },
            "body": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32768
            }
          },
          "required": ["to", "from", "kind", "body"]
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "msg.read"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reader": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:_.-]{0,127}$"
            },
            "role": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:_.-]{0,127}$"
            },
            "through": {
              "type": "string",
              "pattern": "^ev-[a-f0-9-]{36}$"
            }
          },
          "required": ["reader", "role", "through"]
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "step.started"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "step": {
              "enum": [
                "research",
                "frame-problem",
                "write-spec",
                "cut-scopes",
                "slice-work",
                "build-slice",
                "verify-works",
                "review-code",
                "open-pr",
                "prepare-launch",
                "ramp-exposure",
                "measure-impact",
                "decide-next"
              ]
            },
            "run": {
              "type": "string",
              "pattern": "^run-[a-f0-9]{16}$"
            },
            "mode": {
              "enum": ["standalone", "flow"]
            },
            "input": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["step", "run", "mode", "input"]
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "step.completed"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "step": {
              "enum": [
                "research",
                "frame-problem",
                "write-spec",
                "cut-scopes",
                "slice-work",
                "build-slice",
                "verify-works",
                "review-code",
                "open-pr",
                "prepare-launch",
                "ramp-exposure",
                "measure-impact",
                "decide-next"
              ]
            },
            "run": {
              "type": "string",
              "pattern": "^run-[a-f0-9]{16}$"
            },
            "artifact": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "content": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": ["path", "content"]
            }
          },
          "required": ["step", "run", "artifact"]
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "step.skipped"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "step": {
              "enum": [
                "research",
                "frame-problem",
                "write-spec",
                "cut-scopes",
                "slice-work",
                "build-slice",
                "verify-works",
                "review-code",
                "open-pr",
                "prepare-launch",
                "ramp-exposure",
                "measure-impact",
                "decide-next"
              ]
            },
            "run": {
              "type": "string",
              "pattern": "^run-[a-f0-9]{16}$"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["step", "run", "reason"]
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "answer.remembered"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "qid": {
              "enum": ["owner", "input", "docs.destination", "tracker.destination"]
            },
            "value": {
              "type": "string",
              "minLength": 1
            },
            "scope": {
              "enum": ["run", "initiative"]
            },
            "run": {
              "type": "string",
              "pattern": "^run-[a-f0-9]{16}$"
            }
          },
          "required": ["qid", "value", "scope", "run"]
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "decision.recorded"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "decision": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "outcome": {
              "enum": ["approved", "rejected"]
            },
            "by": {
              "type": "string",
              "minLength": 1
            },
            "basis": {
              "type": "string",
              "pattern": "^ev-[a-f0-9-]{36}$"
            }
          },
          "required": ["decision", "outcome", "by", "basis"]
        }
      }
    }
  ]
}
