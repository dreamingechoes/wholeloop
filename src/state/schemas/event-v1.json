            "reopen": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["run", "outcome", "reason"]
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "scope.defined"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "initiative": {
              "type": "string",
              "pattern": "^init-[a-f0-9]{8}$"
            },
            "run": {
              "type": "string",
              "pattern": "^run-[a-f0-9]{16}$"
            },
            "definition": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "key": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]*$"
