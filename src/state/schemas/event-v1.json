            "vote": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "claim": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9:.-]{0,160}$"
                },
                "verifier": {
                  "type": "integer",
                  "minimum": 1
                },
                "outcome": {
                  "type": "string",
                  "enum": ["refute", "confirm", "uncertain"]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "ref": {
                        "type": "string",
                        "minLength": 1
                      },
                      "excerpt": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": ["ref", "excerpt"]
                  }
                }
              },
              "required": ["claim", "verifier", "outcome", "reason", "evidence"]
            }
          },
          "required": ["run", "vote"]
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "frame.sourced"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "run": {
              "type": "string",
              "pattern": "^run-[a-f0-9]{16}$"
            },
            "brief": {
              "type": "string",
              "pattern": "^brief-[a-f0-9]{8}$"
            },
            "artifact": {
              "type": "string",
              "pattern": "^items/brief-[a-f0-9]{8}/artifacts/research/run-[a-f0-9]{16}\\.md$"
            }
          },
          "required": ["run", "brief", "artifact"]
        }
      }
    },
    {
      "properties": {
        "type": {
