{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wholeloop/state-event@1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "v": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^ev-[a-f0-9-]{36}$"
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": ["person", "agent", "system"]
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["kind", "name"]
    },
    "subject": {
      "type": "string",
      "pattern": "^(init|scope|slice|part|brief|review)-[a-f0-9]{8}$"
    },
    "type": {
      "type": "string"
    },
    "data": {
      "type": "object"
    }
  },
  "required": ["v", "id", "ts", "actor", "subject", "type", "data"],
  "oneOf": [
    {
      "properties": {
        "type": {
          "const": "item.created"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": ["initiative", "scope", "slice", "part", "brief", "review"]
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "owner": {
              "type": "string",
              "minLength": 1
            },
            "body": {
              "type": "string"
            },
            "parent": {
              "type": "string",
              "pattern": "^(init|scope|slice|part|brief|review)-[a-f0-9]{8}$"
            }
          },
          "required": ["kind", "title", "owner", "body"]
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "item.updated"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "owner": {
              "type": "string",
              "minLength": 1
            },
            "body": {
              "type": "string"
            },
            "status": {
              "enum": ["open", "closed"]
            }
          },
          "required": [],
          "minProperties": 1
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "item.closed"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {},
          "required": []
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "note.added"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["text"]
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "link.added"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^https?://"
            }
          },
          "required": ["url"]
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "msg.sent"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "to": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:_.-]{0,127}$"
            },
            "from": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:_.-]{0,127}$"
            },
            "kind": {
              "enum": ["contract", "handoff", "status", "question", "note"]
            },
            "body": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32768
            }
          },
          "required": ["to", "from", "kind", "body"]
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "msg.read"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reader": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:_.-]{0,127}$"
            },
            "role": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:_.-]{0,127}$"
            },
            "through": {
              "type": "string",
              "pattern": "^ev-[a-f0-9-]{36}$"
            }
          },
          "required": ["reader", "role", "through"]
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "step.started"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "step": {
              "enum": [
                "research",
                "frame-problem",
                "write-spec",
                "cut-scopes",
                "slice-work",
                "build-slice",
                "verify-works",
                "review-code",
                "open-pr",
                "prepare-launch",
                "ramp-exposure",
                "measure-impact",
                "decide-next"
              ]
            },
            "run": {
              "type": "string",
              "pattern": "^run-[a-f0-9]{16}$"
            },
            "mode": {
              "enum": ["standalone", "flow"]
            },
            "input": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["step", "run", "mode", "input"]
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "step.completed"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "step": {
              "enum": [
                "research",
                "frame-problem",
                "write-spec",
                "cut-scopes",
                "slice-work",
                "build-slice",
                "verify-works",
                "review-code",
                "open-pr",
                "prepare-launch",
                "ramp-exposure",
                "measure-impact",
                "decide-next"
              ]
            },
            "run": {
              "type": "string",
              "pattern": "^run-[a-f0-9]{16}$"
            },
            "artifact": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "content": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": ["path", "content"]
            }
          },
          "required": ["step", "run", "artifact"]
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "step.skipped"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "step": {
              "enum": [
                "research",
                "frame-problem",
                "write-spec",
                "cut-scopes",
                "slice-work",
                "build-slice",
                "verify-works",
                "review-code",
                "open-pr",
                "prepare-launch",
                "ramp-exposure",
                "measure-impact",
                "decide-next"
              ]
            },
            "run": {
              "type": "string",
              "pattern": "^run-[a-f0-9]{16}$"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["step", "run", "reason"]
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "answer.remembered"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "qid": {
              "enum": ["owner", "input", "docs.destination", "tracker.destination"]
            },
            "value": {
              "type": "string",
              "minLength": 1
            },
            "scope": {
              "enum": ["run", "initiative"]
            },
            "run": {
              "type": "string",
              "pattern": "^run-[a-f0-9]{16}$"
            }
          },
          "required": ["qid", "value", "scope", "run"]
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "decision.recorded"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "decision": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "outcome": {
              "enum": ["approved", "rejected"]
            },
            "by": {
              "type": "string",
              "minLength": 1
            },
            "basis": {
              "type": "string",
              "pattern": "^ev-[a-f0-9-]{36}$"
            }
          },
          "required": ["decision", "outcome", "by", "basis"]
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "research.planned"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "run": {
              "type": "string",
              "pattern": "^run-[a-f0-9]{16}$"
            },
            "plan": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "schema": {
                  "type": "string",
                  "const": "wholeloop/research-plan@1"
                },
                "subject": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9:.-]{0,160}$"
                },
                "run": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9:.-]{0,160}$"
                },
                "question": {
                  "type": "string",
                  "minLength": 1
                },
                "owner": {
                  "type": "string",
                  "minLength": 1
                },
                "verifiers": {
                  "type": "integer",
                  "enum": [3, 5, 7, 9]
                },
                "refutations": {
                  "type": "integer",
                  "minimum": 2
                },
                "angles": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[a-z0-9][a-z0-9:.-]{0,160}$"
                      },
                      "provider": {
                        "type": "string",
                        "pattern": "^[a-z0-9][a-z0-9:.-]{0,160}$"
                      },
                      "capability": {
                        "type": "string",
                        "minLength": 1
                      },
                      "operation": {
                        "type": "string",
                        "minLength": 1
                      },
                      "available": {
                        "type": "boolean"
                      },
                      "evidence": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "id",
                      "provider",
                      "capability",
                      "operation",
                      "available",
                      "evidence"
                    ]
                  }
                },
                "openQuestions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "question": {
                        "type": "string",
                        "minLength": 1
                      },
                      "missing": {
                        "type": "string",
                        "minLength": 1
                      },
                      "who": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": ["question", "missing", "who"]
                  }
                }
              },
              "required": [
                "schema",
                "subject",
                "run",
                "question",
                "owner",
                "verifiers",
                "refutations",
                "angles",
                "openQuestions"
              ]
            }
          },
          "required": ["run", "plan"]
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "research.submitted"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "run": {
              "type": "string",
              "pattern": "^run-[a-f0-9]{16}$"
            },
            "result": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "angle": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9:.-]{0,160}$"
                },
                "status": {
                  "type": "string",
                  "enum": ["ok", "unavailable"]
                },
                "claims": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[a-z0-9][a-z0-9:.-]{0,160}$"
                      },
                      "text": {
                        "type": "string",
                        "minLength": 1
                      },
                      "confidence": {
                        "type": "string",
                        "enum": ["low", "medium", "high"]
                      },
                      "loadBearing": {
                        "type": "boolean"
                      },
                      "evidence": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "ref": {
                              "type": "string",
                              "minLength": 1
                            },
                            "excerpt": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "required": ["ref", "excerpt"]
                        },
                        "minItems": 1
                      }
                    },
                    "required": ["id", "text", "confidence", "loadBearing", "evidence"]
                  }
                },
                "openQuestions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "question": {
                        "type": "string",
                        "minLength": 1
                      },
                      "missing": {
                        "type": "string",
                        "minLength": 1
                      },
                      "who": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": ["question", "missing", "who"]
                  }
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": ["angle", "status", "claims", "openQuestions"]
            }
          },
          "required": ["run", "result"]
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "research.examined"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "run": {
              "type": "string",
              "pattern": "^run-[a-f0-9]{16}$"
            },
            "vote": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "claim": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9:.-]{0,160}$"
                },
                "verifier": {
                  "type": "integer",
                  "minimum": 1
                },
                "outcome": {
                  "type": "string",
                  "enum": ["refute", "confirm", "uncertain"]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "ref": {
                        "type": "string",
                        "minLength": 1
                      },
                      "excerpt": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": ["ref", "excerpt"]
                  }
                }
              },
              "required": ["claim", "verifier", "outcome", "reason", "evidence"]
            }
          },
          "required": ["run", "vote"]
        }
      }
    }
  ]
}
