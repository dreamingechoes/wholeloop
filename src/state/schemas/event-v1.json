                    },
                    "flag": {
                      "type": "string",
                      "minLength": 1
                    },
                    "withoutFlagReason": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": ["mode"]
                },
                "complexity": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "level": {
                      "type": "string",
                      "enum": ["simple", "complex"]
                    },
                    "why": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": ["level", "why"]
                },
                "after": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 0,
                  "uniqueItems": true
                }
              },
              "required": ["key", "title", "goal", "metrics", "delivery", "complexity"]
            },
            "after": {
              "type": "array",
              "items": {
                "type": "string",
