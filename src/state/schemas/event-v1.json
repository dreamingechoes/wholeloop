                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "minItems": 1,
                      "uniqueItems": true
                    },
                    "expected": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": ["entry", "steps", "expected"]
                },
                "criteria": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_-]*$"
                      },
                      "text": {
                        "type": "string",
                        "minLength": 1
                      },
                      "test": {
                        "type": "string",
                        "minLength": 1
                      },
                      "assertion": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "subject": {
                            "type": "string",
                            "minLength": 1
                          },
                          "context": {
                            "type": "string",
                            "minLength": 1
                          },
                          "unit": {
                            "type": "string",
                            "minLength": 1
                          },
                          "operator": {
                            "type": "string",
                            "enum": ["lt", "lte", "eq", "ne", "gte", "gt"]
                          },
                          "value": {
                            "type": "number"
                          }
                        },
                        "required": ["subject", "context", "unit", "operator", "value"]
