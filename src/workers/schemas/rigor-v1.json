{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wholeloop/run-rigor@1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "run": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9:.-]{0,160}$"
    },
    "rigor": {
      "type": "string",
      "enum": ["quick", "standard", "deep"]
    },
    "proposed": {
      "type": "string",
      "enum": ["quick", "standard", "deep"]
    },
    "source": {
      "type": "string",
      "enum": ["person", "default"]
    }
  },
  "required": ["run", "rigor", "proposed", "source"]
}
