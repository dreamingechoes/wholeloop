{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wholeloop/private-acceptance@1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "run": {
      "type": "string",
      "minLength": 1,
      "maxLength": 25,
      "pattern": "^delivery-[a-f0-9]{16}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "plan": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "schema": {
      "type": "string",
      "const": "wholeloop/private-acceptance@1"
    },
    "case": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "type": "string",
          "const": "wholeloop/behavior-input@1"
        },
        "kind": {
          "type": "string",
          "enum": ["cli", "api"]
        },
        "service": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              "kind": {
                "type": "string",
                "enum": ["request", "restart"]
              },
              "method": {
                "type": "string",
                "enum": ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"]
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "body": {
                "type": "string",
                "maxLength": 1048576
              },
              "headers": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "accept": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "content-type": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                },
                "required": []
              }
            },
            "required": ["id", "kind"]
          },
          "minItems": 1,
          "maxItems": 16
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "assertion": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              "step": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              }
            },
            "required": ["assertion", "step"]
          },
          "minItems": 0,
          "maxItems": 100
        },
        "stdin": {
          "type": "string",
          "maxLength": 1048576
        }
      },
      "required": ["schema", "kind", "service"]
    },
    "assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "subject": {
            "type": "string",
            "enum": ["exit", "stdout", "stderr", "json", "status", "header", "state", "semantic"]
          },
          "operator": {
            "type": "string",
            "enum": ["equals", "contains", "present", "absent"]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "expected": {
            "type": "string",
            "maxLength": 65536
          }
        },
        "required": ["id", "description", "subject", "operator"]
      },
      "minItems": 1,
      "maxItems": 100
    },
    "sensitivity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["regression", "new-feature", "not-applicable"]
        },
        "relevant": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          }
        },
        "mutation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "service": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            },
            "command": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            }
          },
          "required": ["service", "command"]
        }
      },
      "required": ["mode", "relevant"]
    }
  },
  "required": [
    "run",
    "revision",
    "plan",
    "source",
    "schema",
    "case",
    "behavior",
    "assertions",
    "sensitivity"
  ]
}
