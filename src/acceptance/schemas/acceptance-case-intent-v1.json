{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wholeloop/acceptance-case-intent@1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "const": "wholeloop/acceptance-case-intent@1"
    },
    "plan": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "case": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "invocation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "environment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 44,
          "pattern": "^environment-[a-f0-9]{32}$"
        },
        "recipe": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "runtime": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "repository": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              "head": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-f0-9]{40,64}$"
              },
              "snapshot": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": ["repository", "head", "snapshot"]
          },
          "minItems": 1,
          "maxItems": 32
        }
      },
      "required": ["environment", "recipe", "runtime", "candidates"]
    },
    "at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "deadline": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "capability": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": ["id", "version", "capability"]
    },
    "provenance": {
      "type": "string",
      "enum": ["fixture", "host-observed"]
    }
  },
  "required": [
    "schema",
    "plan",
    "case",
    "key",
    "sequence",
    "invocation",
    "bindings",
    "at",
    "deadline",
    "host",
    "provenance"
  ]
}
