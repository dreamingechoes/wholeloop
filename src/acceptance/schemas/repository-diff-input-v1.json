{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wholeloop/repository-diff-input@1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": { "type": "string", "const": "wholeloop/repository-diff-input@1" },
    "repository": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    }
  },
  "required": ["schema", "repository"]
}
