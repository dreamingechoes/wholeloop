{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wholeloop/behavior-input@1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "const": "wholeloop/behavior-input@1"
    },
    "kind": {
      "type": "string",
      "enum": ["cli", "api"]
    },
    "service": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "command": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "kind": {
            "type": "string",
            "enum": ["request", "restart"]
          },
          "method": {
            "type": "string",
            "enum": ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "body": {
            "type": "string",
            "maxLength": 1048576
          },
          "headers": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "accept": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "content-type": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            },
            "required": []
          }
        },
        "required": ["id", "kind"]
      },
      "minItems": 1,
      "maxItems": 16
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "assertion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "step": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          }
        },
        "required": ["assertion", "step"]
      },
      "minItems": 0,
      "maxItems": 100
    },
    "stdin": {
      "type": "string",
      "maxLength": 1048576
    }
  },
  "required": ["schema", "kind", "service"]
}
