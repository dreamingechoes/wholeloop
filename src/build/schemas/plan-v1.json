{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wholeloop/builder-plan@1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "const": "wholeloop/builder-plan@1"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": ["verified", "unknown", "contradicted"]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["text", "status", "evidence"]
      }
    }
  },
  "required": ["schema", "steps", "tests", "assumptions"]
}
