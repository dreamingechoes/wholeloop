{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wholeloop/launch-kit@1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "const": "wholeloop/launch-kit@1"
    },
    "sourceDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "rolloutPlan": {
      "type": "string",
      "minLength": 1
    },
    "comms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "audience": {
            "type": "string",
            "minLength": 1
          },
          "stage": {
            "type": "string",
            "minLength": 1
          },
          "body": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["key", "audience", "stage", "body"]
      }
    },
    "dashboards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "metric": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          }
        },
        "required": ["key", "title", "metric"]
      }
    },
    "enablement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "supportGuide": {
          "type": "string",
          "minLength": 1
        },
        "onePager": {
          "type": "string",
          "minLength": 1
        },
        "runbook": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["supportGuide", "onePager", "runbook"]
    }
  },
  "required": ["schema", "sourceDigest", "rolloutPlan", "comms", "dashboards", "enablement"]
}
