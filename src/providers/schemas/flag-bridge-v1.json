{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wholeloop/flag-bridge@1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "provider", "baseUrl", "project", "tokenEnv"],
  "properties": {
    "schema": { "type": "string", "const": "wholeloop/flag-bridge@1" },
    "provider": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "baseUrl": { "type": "string" },
    "project": { "type": "string" },
    "tokenEnv": { "type": "string" }
  }
}
