{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wholeloop/grafana-dashboard-bridge@1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "provider",
    "baseUrl",
    "tokenEnv",
    "namespace",
    "dashboardUid",
    "folderUid",
    "datasourceUid",
    "queryLanguage",
    "artifactDigest"
  ],
  "properties": {
    "schema": { "type": "string", "const": "wholeloop/grafana-dashboard-bridge@1" },
    "provider": { "type": "string", "const": "grafana" },
    "baseUrl": { "type": "string" },
    "tokenEnv": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$" },
    "namespace": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,61}[a-z0-9]$" },
    "dashboardUid": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,38}[a-z0-9]$" },
    "folderUid": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,40}$" },
    "datasourceUid": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,40}$" },
    "queryLanguage": { "type": "string", "const": "promql" },
    "artifactDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
