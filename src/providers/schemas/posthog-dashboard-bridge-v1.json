{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wholeloop/posthog-dashboard-bridge@1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "provider",
    "baseUrl",
    "tokenEnv",
    "organization",
    "project",
    "queryLanguage",
    "artifactDigest"
  ],
  "properties": {
    "schema": { "type": "string", "const": "wholeloop/posthog-dashboard-bridge@1" },
    "provider": { "type": "string", "const": "posthog" },
    "baseUrl": { "type": "string" },
    "tokenEnv": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$" },
    "organization": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
    },
    "project": { "type": "string", "pattern": "^[1-9][0-9]{0,14}$" },
    "queryLanguage": { "type": "string", "const": "hogql" },
    "artifactDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
