{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wholeloop/posthog-flag-bridge@1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "provider", "baseUrl", "project", "environment", "tokenEnv"],
  "properties": {
    "schema": { "type": "string", "const": "wholeloop/posthog-flag-bridge@1" },
    "provider": { "type": "string", "const": "posthog" },
    "baseUrl": { "type": "string" },
    "project": { "type": "string", "pattern": "^[1-9][0-9]{0,14}$" },
    "environment": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "tokenEnv": { "type": "string" }
  }
}
