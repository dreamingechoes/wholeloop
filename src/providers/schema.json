{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wholeloop/provider@1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "extends": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "type": "array",
      "items": {
        "enum": [
          "source.web",
          "source.code",
          "source.product-analytics",
          "source.bi",
          "source.support",
          "source.errors",
          "source.observability",
          "source.knowledge",
          "source.feedback",
          "source.meetings",
          "docs",
          "tracker",
          "codehost",
          "dashboards",
          "flags",
          "comms",
          "design"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "native": {
          "const": true
        },
        "local": {
          "const": true
        },
        "cli": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "binary": {
              "type": "string",
              "minLength": 1
            },
            "detect": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["binary"]
        },
        "mcp": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "server": {
              "type": "string",
              "minLength": 1
            },
            "detect": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "tools": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": ["tools"]
            },
            "install": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "transport": {
                  "enum": ["http", "stdio"]
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "command": {
                  "type": "string",
                  "minLength": 1
                },
                "args": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "auth": {
                  "enum": ["oauth", "header", "none"]
                },
                "token_env": {
                  "type": "string",
                  "pattern": "^[A-Z_][A-Z0-9_]*$"
                }
              },
              "required": ["transport"],
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "transport": {
                        "const": "http"
                      }
                    }
                  },
                  "then": {
                    "required": ["url"]
                  },
                  "else": {
                    "required": ["command"]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "auth": {
                        "const": "header"
                      }
                    },
                    "required": ["auth"]
                  },
                  "then": {
                    "required": ["token_env"]
                  }
                }
              ]
            }
          },
          "required": ["server", "install"]
        }
      },
      "required": [],
      "minProperties": 1
    },
    "operations": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "enum": [
          "source.web.query",
          "source.code.query",
          "source.product-analytics.query",
          "source.bi.query",
          "source.support.query",
          "source.errors.query",
          "source.observability.query",
          "source.knowledge.query",
          "source.feedback.query",
          "source.meetings.query",
          "docs.create",
          "docs.read",
          "docs.update",
          "docs.link",
          "tracker.create-item",
          "tracker.read-item",
          "tracker.update-item",
          "tracker.link-items",
          "tracker.transition",
          "codehost.open-draft-pr",
          "codehost.read-pr",
          "codehost.pr-status",
          "dashboards.create",
          "dashboards.update",
          "dashboards.read",
          "flags.read-state",
          "flags.propose-change",
          "comms.draft",
          "design.read-context"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tool": {
            "type": "string",
            "minLength": 1
          },
          "args": {
            "type": "object"
          },
          "guidance": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["tool"]
      }
    },
    "degrade": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "source.web.query",
          "source.code.query",
          "source.product-analytics.query",
          "source.bi.query",
          "source.support.query",
          "source.errors.query",
          "source.observability.query",
          "source.knowledge.query",
          "source.feedback.query",
          "source.meetings.query",
          "docs.create",
          "docs.read",
          "docs.update",
          "docs.link",
          "tracker.create-item",
          "tracker.read-item",
          "tracker.update-item",
          "tracker.link-items",
          "tracker.transition",
          "codehost.open-draft-pr",
          "codehost.read-pr",
          "codehost.pr-status",
          "dashboards.create",
          "dashboards.update",
          "dashboards.read",
          "flags.read-state",
          "flags.propose-change",
          "comms.draft",
          "design.read-context"
        ]
      },
      "additionalProperties": {
        "enum": ["open-question", "handoff-artifact", "skip-with-reason"]
      }
    }
  },
  "required": [
    "schema",
    "id",
    "name",
    "description",
    "capabilities",
    "access",
    "operations",
    "degrade"
  ]
}
