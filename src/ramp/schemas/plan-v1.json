{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wholeloop/ramp-plan@1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "const": "wholeloop/ramp-plan@1"
    },
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "flag": {
      "type": "string",
      "minLength": 1
    },
    "confirmedBy": {
      "type": "string",
      "minLength": 1
    },
    "sourceDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "audience": {
            "type": "string",
            "minLength": 1
          },
          "enabled": {
            "type": "boolean"
          },
          "exposure": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "exit": {
            "type": "string",
            "minLength": 1
          },
          "checks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "key": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]*$"
                },
                "provider": {
                  "type": "string",
                  "minLength": 1
                },
                "operation": {
                  "type": "string",
                  "minLength": 1
                },
                "query": {
                  "type": "string",
                  "minLength": 1
                },
                "unit": {
                  "type": "string",
                  "minLength": 1
                },
                "operator": {
                  "type": "string",
                  "enum": ["lt", "lte", "eq", "gte", "gt"]
                },
                "threshold": {
                  "type": "number"
                },
                "required": {
                  "type": "boolean"
                },
                "lookbackHours": {
                  "type": "number",
                  "minimum": 0.001,
                  "maximum": 8760
                },
                "timezone": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "key",
                "provider",
                "operation",
                "query",
                "unit",
                "operator",
                "threshold",
                "required",
                "lookbackHours",
                "timezone"
              ]
            }
          }
        },
        "required": ["key", "audience", "enabled", "exposure", "exit", "checks"]
      }
    }
  },
  "required": ["schema", "environment", "confirmedBy", "stages"]
}
