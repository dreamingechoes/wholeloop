{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wholeloop/release-context@1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "const": "wholeloop/release-context@1"
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "public": {
      "type": "boolean"
    },
    "defaultBranch": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
    },
    "ref": {
      "type": "string",
      "pattern": "^refs/(heads|tags)/[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "event": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "workflow": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}\\.ya?ml$"
    }
  },
  "required": [
    "schema",
    "repository",
    "public",
    "defaultBranch",
    "ref",
    "commit",
    "event",
    "workflow"
  ]
}
