{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wholeloop/delegated-decision-request@1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "const": "wholeloop/delegated-decision-request@1"
    },
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,127}$",
      "maxLength": 128
    },
    "grant": {
      "type": "string",
      "pattern": "^authorization-[a-f0-9]{16}$"
    },
    "run": {
      "type": "string",
      "pattern": "^delivery-[a-f0-9]{16}$",
      "maxLength": 25
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "plan": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "maxLength": 64
    },
    "decision": {
      "type": "string",
      "enum": [
        "delivery-plan",
        "research-plan",
        "research-sources",
        "frame-outcome",
        "approve-spec",
        "approve-scopes",
        "approve-build-plan",
        "acceptance",
        "learning-outcome",
        "ramp-assessment"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "maxLength": 64
          }
        },
        "required": ["ref", "sha256"]
      },
      "minItems": 1,
      "maxItems": 100
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "maxLength": 64
          }
        },
        "required": ["id", "ref", "sha256"]
      },
      "minItems": 1,
      "maxItems": 100
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,127}$",
            "maxLength": 128
          },
          "missing": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "who": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": ["id", "missing", "who"]
      },
      "minItems": 0,
      "maxItems": 100
    }
  },
  "required": [
    "schema",
    "key",
    "grant",
    "run",
    "revision",
    "plan",
    "decision",
    "artifacts",
    "evidence",
    "unknowns"
  ]
}
