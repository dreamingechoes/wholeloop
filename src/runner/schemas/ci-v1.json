{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wholeloop/delivery-ci@1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "codeHost",
    "repository",
    "pr",
    "candidate",
    "head",
    "base",
    "observedAt",
    "complete",
    "checks",
    "protection",
    "reviews",
    "provenance"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "wholeloop/delivery-ci@1"
    },
    "codeHost": {
      "type": "string",
      "enum": ["github"]
    },
    "repository": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^https://"
    },
    "pr": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^https://"
    },
    "candidate": {
      "type": "string",
      "pattern": "^[a-f0-9]{40,64}$"
    },
    "head": {
      "type": "string",
      "pattern": "^[a-f0-9]{40,64}$"
    },
    "base": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "observedAt": {
      "type": "string",
      "maxLength": 64
    },
    "complete": {
      "type": "boolean"
    },
    "checks": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "attempt", "head", "status"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "issuer": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._:-]+$"
          },
          "attempt": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          },
          "head": {
            "type": "string",
            "pattern": "^[a-f0-9]{40,64}$"
          },
          "status": {
            "type": "string",
            "enum": ["queued", "in_progress", "completed"]
          },
          "conclusion": {
            "type": "string",
            "enum": [
              "success",
              "failure",
              "cancelled",
              "skipped",
              "neutral",
              "timed_out",
              "action_required",
              "stale"
            ]
          }
        }
      }
    },
    "protection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "required"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["observed", "unknown"]
        },
        "required": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "issuer": {
                "type": "string",
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9._:-]+$"
              }
            }
          }
        },
        "strict": {
          "type": "boolean"
        }
      }
    },
    "reviews": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["observed", "unknown"]
        },
        "required": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "approvals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      }
    },
    "provenance": {
      "type": "string",
      "enum": ["fixture", "host-observed"]
    }
  }
}
