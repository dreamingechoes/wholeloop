{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wholeloop/delivery-runner-status@1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "wholeloop/delivery-runner-status@1"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "type": "string",
          "const": "wholeloop/delivery-runner-request@1"
        },
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,127}$"
        },
        "run": {
          "type": "string",
          "pattern": "^delivery-[a-f0-9]{16}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "plan": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "maxLength": 64
        },
        "grant": {
          "type": "string",
          "pattern": "^authorization-[a-f0-9]{16}$"
        },
        "host": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "configuration": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$",
              "maxLength": 64
            }
          },
          "required": ["id", "version", "configuration"]
        },
        "pollMs": {
          "type": "integer",
          "minimum": 50,
          "maximum": 1000
        }
      },
      "required": ["schema", "key", "run", "revision", "plan", "grant", "host", "pollMs"]
    },
    "state": {
      "type": "string",
      "enum": [
        "planned",
        "queued",
        "running",
        "paused",
        "stopping",
        "stopped",
        "waiting-input",
        "waiting-external",
        "completed",
        "failed",
        "blocked",
        "exhausted"
      ]
    },
    "outcome": {
      "type": ["string", "null"]
    },
    "ownership": {
      "type": "string",
      "enum": ["unclaimed", "active", "released", "unknown"]
    },
    "controller": {
      "type": ["string", "null"],
      "pattern": "^controller-[a-f0-9]{32}$"
    },
    "generation": {
      "type": "integer",
      "minimum": 0
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9:_-]{0,255}$",
            "maxLength": 256
          },
          "invocation": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "maxLength": 64
          },
          "status": {
            "type": "string",
            "enum": [
              "prepared",
              "running",
              "passed",
              "failed",
              "blocked",
              "pending",
              "unknown",
              "stopped",
              "not-started"
            ]
          },
          "runtime": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "backend": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "instance": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "worker": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            },
            "required": ["backend", "instance", "worker"]
          },
          "evidence": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "maxLength": 64
          },
          "provenance": {
            "type": "string",
            "enum": ["fixture", "host-observed"]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "generation": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          },
          "basis": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "observation": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": ["id", "invocation", "status", "sequence", "generation", "basis"]
      },
      "maxItems": 1000
    },
    "route": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "after", "criteria"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "kind": {
            "type": "string",
            "enum": [
              "definition",
              "plan",
              "acceptance-definition",
              "workspace",
              "build-plan",
              "implementation",
              "verification",
              "review",
              "commit",
              "integration",
              "acceptance",
              "publication",
              "research",
              "handoff"
            ]
          },
          "after": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "criteria": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "milestone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },
    "problems": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "authority": {
      "const": "original-private-grant-only"
    },
    "publication": {
      "const": "not-implied"
    },
    "nativeAcceptance": {
      "const": "not-established-by-inspection"
    }
  },
  "required": [
    "schema",
    "digest",
    "request",
    "state",
    "outcome",
    "ownership",
    "controller",
    "generation",
    "stages",
    "route",
    "problems",
    "authority",
    "publication",
    "nativeAcceptance"
  ]
}
