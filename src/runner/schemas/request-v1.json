{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wholeloop/delivery-runner-request@1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "const": "wholeloop/delivery-runner-request@1"
    },
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,127}$"
    },
    "run": {
      "type": "string",
      "pattern": "^delivery-[a-f0-9]{16}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "plan": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "maxLength": 64
    },
    "grant": {
      "type": "string",
      "pattern": "^authorization-[a-f0-9]{16}$"
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "configuration": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "maxLength": 64
        }
      },
      "required": ["id", "version", "configuration"]
    },
    "pollMs": {
      "type": "integer",
      "minimum": 50,
      "maximum": 1000
    }
  },
  "required": ["schema", "key", "run", "revision", "plan", "grant", "host", "pollMs"]
}
