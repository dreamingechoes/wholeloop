{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wholeloop/delivery-runner-stage-observation@1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "const": "wholeloop/delivery-runner-stage-observation@1"
    },
    "request": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "maxLength": 64
    },
    "stage": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9:_-]{0,255}$",
      "maxLength": 256
    },
    "invocation": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "maxLength": 64
    },
    "status": {
      "type": "string",
      "enum": ["passed", "failed", "blocked", "pending", "unknown", "stopped", "not-started"]
    },
    "invocationState": {
      "type": "string",
      "enum": ["stopped", "not-started", "unknown"]
    },
    "evidence": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "maxLength": 64
    },
    "provenance": {
      "type": "string",
      "enum": ["fixture", "host-observed"]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$",
        "maxLength": 64
      },
      "maxItems": 10
    },
    "plan": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "derivedPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "digest"],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  },
  "required": [
    "schema",
    "request",
    "stage",
    "invocation",
    "status",
    "invocationState",
    "evidence",
    "provenance",
    "reason",
    "plan"
  ]
}
