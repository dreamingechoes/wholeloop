{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wholeloop/delivery-runner@1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "const": "wholeloop/delivery-runner@1"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "request": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "maxLength": 64
          },
          "basis": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "maxLength": 64
          },
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "controller": {
            "type": "string",
            "pattern": "^controller-[a-f0-9]{32}$"
          },
          "generation": {
            "type": "integer",
            "minimum": 0
          },
          "ownership": {
            "type": "string",
            "enum": ["unclaimed", "active", "released", "unknown"]
          },
          "stages": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9:_-]{0,255}$",
                  "maxLength": 256
                },
                "invocation": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$",
                  "maxLength": 64
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "prepared",
                    "running",
                    "passed",
                    "failed",
                    "blocked",
                    "pending",
                    "unknown",
                    "stopped",
                    "not-started"
                  ]
                },
                "runtime": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "backend": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "instance": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "worker": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    }
                  },
                  "required": ["backend", "instance", "worker"]
                },
                "evidence": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$",
                  "maxLength": 64
                },
                "provenance": {
                  "type": "string",
                  "enum": ["fixture", "host-observed"]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "sequence": {
                  "type": "integer",
                  "minimum": 1
                },
                "generation": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000000
                },
                "basis": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "observation": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": ["id", "invocation", "status", "sequence", "generation", "basis"]
            },
            "maxItems": 1000
          },
          "owner": {
            "type": "object",
            "additionalProperties": false,
            "required": ["invocation", "runtime"],
            "properties": {
              "invocation": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "runtime": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "backend": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "instance": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "worker": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                },
                "required": ["backend", "instance", "worker"]
              }
            }
          }
        },
        "required": ["request", "basis", "sequence", "ownership", "generation", "stages"]
      },
      "maxItems": 1000
    }
  },
  "required": ["schema", "records"]
}
