{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wholeloop/sharing-events@1",
  "type": "object",
  "properties": {
    "share.adopted": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "^https://"
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": ["docs", "tracker"],
          "type": "string"
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "origin": {
          "enum": ["host", "import"],
          "type": "string"
        }
      },
      "required": ["ref", "provider", "kind", "revision", "digest", "origin"]
    },
    "share.mode": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": ["local", "shared"],
          "type": "string"
        },
        "by": {
          "type": "string",
          "minLength": 1
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "provider": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": ["docs", "tracker"],
                "type": "string"
              },
              "ref": {
                "type": "string",
                "minLength": 1,
                "pattern": "^https://"
              }
            },
            "required": ["key", "provider", "kind"]
          }
        }
      },
      "required": ["mode", "by", "targets"]
    },
    "share.queued": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "artifact": {
          "type": "string",
          "minLength": 1,
          "pattern": "^ev-[a-f0-9-]{36}$"
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "key": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "enum": ["docs", "tracker"],
              "type": "string"
            },
            "ref": {
              "type": "string",
              "minLength": 1,
              "pattern": "^https://"
            }
          },
          "required": ["key", "provider", "kind"]
        }
      },
      "required": ["key", "artifact", "target"]
    },
    "share.requested": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": ["key"]
    },
    "share.published": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "^https://"
        },
        "origin": {
          "enum": ["host", "import"],
          "type": "string"
        }
      },
      "required": ["key", "ref", "origin"]
    }
  }
}
