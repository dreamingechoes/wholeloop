{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wholeloop/research-code-citations@1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "run": {
      "type": "string",
      "pattern": "^run-[a-f0-9]{16}$"
    },
    "angle": {
      "type": "string",
      "minLength": 1
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "integer",
            "minimum": 0
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "excerptSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "status": {
            "type": "string",
            "const": "verified"
          }
        },
        "required": ["claim", "evidence", "ref", "excerptSha256", "status"]
      }
    }
  },
  "required": ["run", "angle", "checks"]
}
