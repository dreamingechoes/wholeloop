{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wholeloop/research-plan@1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "const": "wholeloop/research-plan@1"
    },
    "subject": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9:.-]{0,160}$"
    },
    "run": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9:.-]{0,160}$"
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "verifiers": {
      "type": "integer",
      "enum": [3, 5, 7, 9]
    },
    "refutations": {
      "type": "integer",
      "minimum": 2
    },
    "angles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9:.-]{0,160}$"
          },
          "provider": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9:.-]{0,160}$"
          },
          "capability": {
            "type": "string",
            "minLength": 1
          },
          "operation": {
            "type": "string",
            "minLength": 1
          },
          "available": {
            "type": "boolean"
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["id", "provider", "capability", "operation", "available", "evidence"]
      }
    },
    "openQuestions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1
          },
          "missing": {
            "type": "string",
            "minLength": 1
          },
          "who": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["question", "missing", "who"]
      }
    }
  },
  "required": [
    "schema",
    "subject",
    "run",
    "question",
    "owner",
    "verifiers",
    "refutations",
    "angles",
    "openQuestions"
  ]
}
