{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wholeloop/research-sources@1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "const": "wholeloop/research-sources@1"
    },
    "subject": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9:.-]{0,160}$"
    },
    "run": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9:.-]{0,160}$"
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "verifiers": {
      "type": "integer",
      "enum": [3, 5, 7, 9]
    },
    "refutations": {
      "type": "integer",
      "minimum": 2
    },
    "angles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9:.-]{0,160}$"
          },
          "provider": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9:.-]{0,160}$"
          },
          "capability": {
            "type": "string",
            "minLength": 1
          },
          "operation": {
            "type": "string",
            "minLength": 1
          },
          "available": {
            "type": "boolean"
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["id", "provider", "capability", "operation", "available", "evidence"]
      },
      "maxItems": 0
    },
    "openQuestions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1
          },
          "missing": {
            "type": "string",
            "minLength": 1
          },
          "who": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["question", "missing", "who"]
      }
    },
    "status": {
      "type": "string",
      "const": "needs-sources"
    },
    "client": {
      "type": "string",
      "minLength": 1
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "access": {
            "type": "string",
            "enum": [
              "native",
              "available in this client",
              "configured in another client",
              "executable only",
              "unavailable"
            ]
          },
          "available": {
            "type": "boolean"
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "configuredClients": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "name",
          "capabilities",
          "access",
          "available",
          "evidence",
          "configuredClients"
        ]
      }
    },
    "suggested": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "unusable": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "server": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "const": "not usable yet"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "clients": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "guide": {
            "type": "string",
            "const": "docs/extending/providers.md"
          }
        },
        "required": ["server", "label", "reason", "clients", "guide"]
      }
    },
    "remember": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["run", "project", "user"]
      }
    },
    "jobs": {
      "type": "array",
      "maxItems": 0
    },
    "examinations": {
      "type": "array",
      "maxItems": 0
    }
  },
  "required": [
    "schema",
    "subject",
    "run",
    "question",
    "owner",
    "verifiers",
    "refutations",
    "angles",
    "openQuestions",
    "status",
    "client",
    "candidates",
    "suggested",
    "unusable",
    "remember",
    "jobs",
    "examinations"
  ]
}
