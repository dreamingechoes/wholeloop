{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wholeloop/suite-start-failure@1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "run": {
      "type": "string",
      "pattern": "^gate-[a-f0-9]{16}$"
    },
    "round": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "unchanged": {
      "const": true,
      "type": "boolean"
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "exitCode": {
            "type": "integer"
          },
          "signal": {
            "type": "string"
          },
          "stdout": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "stderr": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": ["ref", "exitCode", "signal", "stdout", "stderr"]
      }
    },
    "cause": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "executable": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": ["ref", "executable", "code"]
    }
  },
  "required": ["run", "round", "unchanged", "commands", "cause"]
}
