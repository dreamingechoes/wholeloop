{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wholeloop/suite-execution@1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "run": {
      "type": "string",
      "pattern": "^gate-[a-f0-9]{16}$"
    },
    "round": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "isolation": {
      "type": "string",
      "enum": ["docker", "host"]
    },
    "source": {
      "type": "string",
      "enum": ["default", "run", "repository"]
    },
    "image": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/:@+-]{0,254}$"
    },
    "imageId": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "required": ["run", "round", "isolation", "source"]
}
