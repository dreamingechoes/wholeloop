{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wholeloop/suite-setup@1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "run": {
      "type": "string",
      "pattern": "^gate-[a-f0-9]{16}$"
    },
    "round": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "argv": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9_@%+=:,./-]+$" }
    },
    "network": {
      "type": "string",
      "const": "bridge"
    },
    "ran": {
      "type": "boolean"
    }
  },
  "required": ["run", "round", "argv", "network", "ran"]
}
