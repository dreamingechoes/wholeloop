{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wholeloop/criteria@1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "const": "wholeloop/criteria@1"
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "test": {
            "type": "string",
            "minLength": 1
          },
          "assertion": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "subject": {
                "type": "string",
                "minLength": 1
              },
              "context": {
                "type": "string",
                "minLength": 1
              },
              "unit": {
                "type": "string",
                "minLength": 1
              },
              "operator": {
                "type": "string",
                "enum": ["lt", "lte", "eq", "ne", "gte", "gt"]
              },
              "value": {
                "type": "number"
              }
            },
            "required": ["subject", "context", "unit", "operator", "value"]
          }
        },
        "required": ["id", "text", "test"]
      }
    }
  },
  "required": ["schema", "criteria"]
}
