{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wholeloop/cli-output@1",
  "type": "object",
  "required": ["schema"],
  "oneOf": [
    {
      "properties": {
        "schema": {
          "const": "wholeloop/version@1"
        },
        "version": {
          "type": "string"
        }
      },
      "required": ["version"]
    },
    {
      "properties": {
        "schema": {
          "const": "wholeloop/help@1"
        },
        "version": {
          "type": "string"
        },
        "commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/command"
          }
        }
      },
      "required": ["version", "commands"]
    },
    {
      "properties": {
        "schema": {
          "const": "wholeloop/error@1"
        },
        "code": {
          "enum": [1, 2, 3, 4]
        },
        "message": {
          "type": "string"
        }
      },
      "required": ["code", "message"]
    },
    {
      "properties": {
        "schema": {
          "const": "wholeloop/docs-nav@1"
        },
        "pages": {
          "type": "integer"
        },
        "changed": {
          "type": "integer"
        },
        "problems": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["pages", "changed", "problems"]
    },
    {
      "properties": {
        "schema": {
          "const": "wholeloop/docs-check@1"
        },
        "files": {
          "type": "integer"
        },
        "problems": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        }
      },
      "required": ["files", "problems"]
    },
    {
      "properties": {
        "schema": {
          "const": "wholeloop/harness-check@1"
        },
        "files": {
          "type": "integer"
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        }
      },
      "required": ["files", "findings"]
    },
    {
      "properties": {
        "schema": {
          "const": "wholeloop/commit-check@1"
        },
        "problems": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["problems"]
    },
    {
      "properties": {
        "schema": {
          "const": "wholeloop/config-show@1"
        },
        "values": {
          "type": "object"
        },
        "sources": {
          "type": "object"
        }
      },
      "required": ["values"]
    },
    {
      "properties": {
        "schema": {
          "const": "wholeloop/config-schema@1"
        },
        "configSchema": {
          "type": "object"
        }
      },
      "required": ["configSchema"]
    },
    {
      "properties": {
        "schema": {
          "const": "wholeloop/state-create@1"
        },
        "item": {
          "type": "object"
        }
      },
      "required": ["item"]
    },
    {
      "properties": {
        "schema": {
          "const": "wholeloop/state-update@1"
        },
        "item": {
          "type": "object"
        }
      },
      "required": ["item"]
    },
    {
      "properties": {
        "schema": {
          "const": "wholeloop/state-show@1"
        },
        "item": {
          "type": "object"
        },
        "items": {
          "type": "array"
        }
      },
      "anyOf": [
        {
          "required": ["item"]
        },
        {
          "required": ["items"]
        }
      ]
    },
    {
      "properties": {
        "schema": {
          "const": "wholeloop/state-list@1"
        },
        "items": {
          "type": "array"
        }
      },
      "required": ["items"]
    },
    {
      "properties": {
        "schema": {
          "const": "wholeloop/state-get@1"
        },
        "item": {
          "type": "object"
        }
      },
      "required": ["item"]
    },
    {
      "properties": {
        "schema": {
          "const": "wholeloop/state-rebuild@1"
        },
        "files": {
          "type": "integer"
        }
      },
      "required": ["files"]
    },
    {
      "properties": {
        "schema": {
          "const": "wholeloop/note@1"
        },
        "item": {
          "type": "object"
        }
      },
      "required": ["item"]
    },
    {
      "properties": {
        "schema": {
          "const": "wholeloop/link@1"
        },
        "item": {
          "type": "object"
        }
      },
      "required": ["item"]
    },
    {
      "properties": {
        "schema": {
          "const": "wholeloop/open@1"
        },
        "content": {
          "type": "string"
        }
      },
      "required": ["content"]
    },
    {
      "properties": {
        "schema": {
          "const": "wholeloop/msg-send@1"
        },
        "message": {
          "type": "object"
        }
      },
      "required": ["message"]
    },
    {
      "properties": {
        "schema": {
          "const": "wholeloop/msg-read@1"
        },
        "messages": {
          "type": "array"
        }
      },
      "required": ["messages"]
    },
    {
      "properties": {
        "schema": {
          "const": "wholeloop/handoff@1"
        },
        "message": {
          "type": "object"
        }
      },
      "required": ["message"]
    },
    {
      "properties": {
        "schema": {
          "const": "wholeloop/resume@1"
        },
        "subject": {
          "type": "object"
        },
        "totalItems": {
          "type": "integer"
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": ["subject", "totalItems", "truncated"]
    }
  ],
  "$defs": {
    "finding": {
      "type": "object",
      "required": ["file", "rule", "message"],
      "properties": {
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer"
        },
        "rule": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "command": {
      "type": "object",
      "required": ["path", "arguments", "options", "schema", "summary"],
      "properties": {
        "path": {
          "type": "string"
        },
        "arguments": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "schema": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        }
      }
    }
  }
}
