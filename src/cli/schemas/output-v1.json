          "type": "object"
        },
        "totalItems": {
          "type": "integer"
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": ["subject", "totalItems", "truncated"]
    },
    {
      "properties": {
        "schema": {
          "const": "wholeloop/step-begin@1"
        },
        "subject": {},
        "step": {
          "type": "string"
        }
      },
      "required": ["subject", "step"]
    },
    {
      "properties": {
        "schema": {
