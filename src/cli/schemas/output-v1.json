{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wholeloop/cli-output@1",
  "type": "object",
  "required": ["schema"],
  "oneOf": [
    {
      "type": "object",
      "required": [
        "schema",
        "platform",
        "arch",
        "downloads",
        "collection",
        "effects",
        "limitations"
      ],
      "properties": {
        "schema": {
          "const": "wholeloop/conformance-acquisition@1"
        },
        "platform": {
          "enum": ["darwin", "linux"]
        },
        "arch": {
          "enum": ["arm64", "x64"]
        },
        "downloads": {
          "type": "array"
        },
        "collection": {
          "type": "object"
        },
        "effects": {
          "const": "not-performed"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "schema": {
          "const": "wholeloop/conformance-issues@1"
        },
        "asOf": {
          "type": "string"
        },
        "status": {
          "const": "draft"
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key", "cli", "title", "body", "core"]
          }
        },
        "effects": {
          "const": "not-performed"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["schema", "asOf", "status", "issues", "effects", "limitations"]
    },
    {
      "type": "object",
      "properties": {
        "schema": {
          "const": "wholeloop/conformance-results@1"
        },
        "status": {
          "enum": ["completed", "cancelled"]
        },
        "mode": {
          "enum": ["fixture", "live"]
        },
        "planned": {
          "type": "integer",
          "minimum": 1,
          "maximum": 14
        },
        "runs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["channel", "observedAt", "report"]
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["schema", "status", "mode", "planned", "runs", "limitations"]
    },
    {
      "type": "object",
      "properties": {
        "schema": {
          "const": "wholeloop/release-verified@1"
        },
        "status": {
          "const": "verified"
        },
        "repository": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        },
        "workflow": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "npmTag": {
          "enum": ["latest", "next"]
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "bytes", "sha256"]
          }
        },
        "publication": {
          "const": "not-performed"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "schema",
        "status",
        "repository",
        "commit",
        "workflow",
        "version",
        "tag",
        "npmTag",
        "files",
        "publication",
        "limitations"
      ]
    },
    {
      "type": "object",
      "properties": {
        "schema": {
          "const": "wholeloop/release-preflight@1"
        },
        "status": {
          "enum": ["ready", "blocked"]
        },
        "version": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "npmTag": {
          "enum": ["latest", "next"]
        },
        "repository": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        },
        "workflow": {
          "type": "string"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "publication": {
          "const": "not-performed"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "schema",
        "status",
        "version",
        "tag",
        "npmTag",
        "repository",
        "commit",
        "workflow",
        "reasons",
        "publication",
        "limitations"
      ]
    },
    {
      "type": "object",
      "properties": {
        "schema": {
          "const": "wholeloop/release-notes@1"
        },
        "version": {
          "type": "string"
        },
        "status": {
          "enum": ["draft", "needs-review"]
        },
        "publication": {
          "const": "not-performed"
        },
        "impact": {
          "enum": ["major", "minor", "patch", "none"]
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title", "commits"]
          }
        },
        "rejected": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["sha", "reason"]
          }
        },
        "markdown": {
          "type": "string"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "from": {
          "type": ["string", "null"]
        },
        "to": {
          "type": "string"
        }
      },
      "required": [
        "schema",
        "version",
        "status",
        "publication",
        "impact",
        "count",
        "groups",
        "rejected",
        "markdown",
        "limitations",
        "from",
        "to"
      ]
    },
    {
      "type": "object",
      "properties": {
        "schema": {
          "const": "wholeloop/distribution-build@1"
        },
        "output": {
          "type": "string"
        },
        "status": {
          "enum": ["planned", "written", "already-correct"]
        },
        "backup": {
          "type": ["string", "null"]
        },
        "manifest": {
          "type": "object",
          "properties": {
            "schema": {
              "const": "wholeloop/distribution-artifacts@1"
            },
            "publication": {
              "const": "not-performed"
            },
            "conformance": {
              "const": "unverified"
            }
          },
          "required": [
            "schema",
            "target",
            "version",
            "source",
            "core",
            "publication",
            "conformance",
            "targets",
            "files",
            "limitations"
          ]
        }
      },
      "required": ["schema", "output", "status", "backup", "manifest"]
    },
    {
      "type": "object",
      "properties": {
        "schema": {
          "const": "wholeloop/conformance-matrix@1"
        },
        "asOf": {
          "type": "string",
          "format": "date-time"
        },
        "maxAgeHours": {
          "const": 48
        },
        "rows": {
          "type": "array",
          "minItems": 14,
          "maxItems": 14,
          "items": {
            "type": "object",
            "required": [
              "cli",
              "channel",
              "status",
              "evidence",
              "pin",
              "version",
              "observedAt",
              "freshness",
              "assertions"
            ]
          }
        },
        "regressionCandidates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "key",
              "cli",
              "baseline",
              "latest",
              "assertions",
              "baselineRun",
              "latestRun"
            ]
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "documentation": {
          "type": "object",
          "properties": {
            "schema": {
              "const": "wholeloop/conformance-page@1"
            },
            "file": {
              "const": "docs/platforms/README.md"
            },
            "status": {
              "enum": ["current", "stale", "updated"]
            },
            "written": {
              "type": "boolean"
            }
          },
          "required": ["schema", "file", "status", "written"]
        }
      },
      "required": ["schema", "asOf", "maxAgeHours", "rows", "regressionCandidates", "limitations"]
    },
    {
      "type": "object",
      "properties": {
        "schema": {
          "const": "wholeloop/docs-reference@1"
        }
      },
      "required": ["schema", "status", "written", "stale", "updated", "checked"]
    },
    {
      "type": "object",
      "properties": {
        "schema": {
          "const": "wholeloop/conformance-prepared@1"
        }
      },
      "required": [
        "schema",
        "id",
        "cli",
        "pin",
        "root",
        "state",
        "prompt",
        "recipe",
        "evidence",
        "limitations"
      ]
    },
    {
      "type": "object",
      "properties": {
        "schema": {
          "const": "wholeloop/conformance-report@1"
        }
      },
      "required": [
        "schema",
        "id",
        "cli",
        "pin",
        "step",
        "scenario",
        "core",
        "evidence",
        "status",
        "missing",
        "problems",
        "limitations"
      ]
    },
    {
      "type": "object",
      "properties": {
        "schema": {
          "const": "wholeloop/install@1"
        }
      },
      "required": [
        "schema",
        "scope",
        "targets",
        "receipt",
        "status",
        "conformance",
        "authenticated"
      ]
    },
    {
      "type": "object",
      "properties": {
        "schema": {
          "const": "wholeloop/uninstall@1"
        }
      },
      "required": [
        "schema",
        "scope",
        "targets",
        "receipt",
        "status",
        "conformance",
        "authenticated"
      ]
    },
    {
      "type": "object",
      "properties": {
        "schema": {
          "const": "wholeloop/doctor@1"
        }
      },
      "required": ["schema", "status", "checks", "providers", "conformance", "authenticated"]
    },
    {
      "type": "object",
      "properties": {
        "schema": {
          "const": "wholeloop/guard@1"
        },
        "decision": {
          "enum": ["allow", "deny"]
        },
        "policies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["schema", "decision", "policies", "reasons"]
    },
    {
      "type": "object",
      "properties": {
        "schema": {
          "const": "wholeloop/git-guards@1"
        }
      },
      "required": ["schema", "repository", "hooks", "status"]
    },
    {
      "type": "object",
      "properties": {
        "schema": {
          "const": "wholeloop/worktree-create@1"
        }
      },
      "required": ["schema", "created", "record"]
    },
    {
      "type": "object",
      "properties": {
        "schema": {
          "const": "wholeloop/worktree-open@1"
        }
      },
      "required": ["schema", "record", "tested", "environment", "commands"]
    },
    {
      "type": "object",
      "properties": {
        "schema": {
          "const": "wholeloop/worktree-stop@1"
        }
      },
      "required": ["schema", "record", "processes"]
    },
    {
      "type": "object",
      "properties": {
        "schema": {
          "const": "wholeloop/worktree-list@1"
        }
      },
      "required": ["schema", "worktrees"]
    },
    {
      "type": "object",
      "properties": {
        "schema": {
          "const": "wholeloop/worktree-prune@1"
        }
      },
      "required": ["schema", "dryRun", "actions"]
    },
    {
      "type": "object",
      "properties": {
        "schema": {
          "const": "wholeloop/slices-plan@1"
        }
      },
      "required": ["schema", "subject", "criteria", "repositories", "suggestedSlices", "questions"]
    },
    {
      "type": "object",
      "properties": {
        "schema": {
          "const": "wholeloop/slices-schema@1"
        }
      },
      "required": ["schema", "sliceSchema"]
    },
    {
      "type": "object",
      "properties": {
        "schema": {
          "const": "wholeloop/slices-check@1"
        }
      },
      "required": ["schema", "problems"]
    },
    {
      "type": "object",
      "properties": {
        "schema": {
          "const": "wholeloop/definition-eval@1"
        }
      },
      "required": [
        "schema",
        "seed",
        "corpusSha256",
        "evaluator",
        "cases",
        "classes",
        "totals",
        "outcomes"
      ]
    },
    {
      "type": "object",
      "properties": {
        "schema": {
          "const": "wholeloop/challenge-plan@1"
        }
      },
      "required": ["schema", "mode", "source", "coverage", "style", "problems", "instructions"]
    },
    {
      "type": "object",
      "properties": {
        "schema": {
          "const": "wholeloop/challenge-schema@1"
        }
      },
      "required": ["schema", "criteriaSchema"]
    },
    {
      "properties": {
        "schema": {
          "const": "wholeloop/version@1"
        },
        "version": {
          "type": "string"
        }
      },
      "required": ["version"]
    },
    {
      "properties": {
        "schema": {
          "const": "wholeloop/help@1"
        },
        "version": {
          "type": "string"
        },
        "commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/command"
          }
        }
      },
      "required": ["version", "commands"]
    },
    {
      "properties": {
        "schema": {
          "const": "wholeloop/error@1"
        },
        "code": {
          "enum": [1, 2, 3, 4]
        },
        "message": {
          "type": "string"
        }
      },
      "required": ["code", "message"]
    },
    {
      "properties": {
        "schema": {
          "const": "wholeloop/docs-nav@1"
        },
        "pages": {
          "type": "integer"
        },
        "changed": {
          "type": "integer"
        },
        "problems": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["pages", "changed", "problems"]
    },
    {
      "properties": {
        "schema": {
          "const": "wholeloop/docs-check@1"
        },
        "files": {
          "type": "integer"
        },
        "problems": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        }
      },
      "required": ["files", "problems"]
    },
    {
      "properties": {
        "schema": {
          "const": "wholeloop/harness-check@1"
        },
        "files": {
          "type": "integer"
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        }
      },
      "required": ["files", "findings"]
    },
    {
      "properties": {
        "schema": {
          "const": "wholeloop/commit-check@1"
        },
        "problems": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["problems"]
    },
    {
      "properties": {
        "schema": {
          "const": "wholeloop/config-show@1"
        },
        "values": {
          "type": "object"
        },
        "sources": {
          "type": "object"
        }
      },
      "required": ["values"]
    },
    {
      "properties": {
        "schema": {
          "const": "wholeloop/config-schema@1"
