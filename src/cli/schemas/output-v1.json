          "const": "wholeloop/state-update@1"
        },
        "item": {
          "type": "object"
        }
      },
      "required": ["item"]
    },
    {
      "properties": {
        "schema": {
          "const": "wholeloop/state-show@1"
        },
        "item": {
          "type": "object"
        },
        "items": {
          "type": "array"
        }
      },
      "anyOf": [
        {
          "required": ["item"]
        },
        {
          "required": ["items"]
        }
      ]
    },
    {
      "properties": {
        "schema": {
          "const": "wholeloop/state-list@1"
        },
        "items": {
          "type": "array"
        }
      },
      "required": ["items"]
    },
    {
