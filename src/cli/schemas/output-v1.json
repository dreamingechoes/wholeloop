    },
    {
      "properties": {
        "schema": {
          "const": "wholeloop/provider-test@1"
        },
        "providers": {
          "type": "array"
        },
        "problems": {
          "type": "array"
        }
      },
      "required": ["providers", "problems"]
    },
    {
      "properties": {
        "schema": {
