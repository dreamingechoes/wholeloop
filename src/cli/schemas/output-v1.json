        }
      },
      "required": ["item"]
    },
    {
      "properties": {
        "schema": {
          "const": "wholeloop/state-rebuild@1"
        },
        "files": {
          "type": "integer"
        }
      },
      "required": ["files"]
    },
    {
      "properties": {
        "schema": {
          "const": "wholeloop/note@1"
        },
        "item": {
          "type": "object"
        }
      },
      "required": ["item"]
    },
    {
      "properties": {
        "schema": {
          "const": "wholeloop/link@1"
        },
        "item": {
          "type": "object"
        }
      },
      "required": ["item"]
    },
    {
      "properties": {
        "schema": {
          "const": "wholeloop/open@1"
        },
        "content": {
          "type": "string"
        }
      },
      "required": ["content"]
    },
    {
