{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wholeloop/frame-decision@1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "by", "outcome", "reason", "stopConditions"],
  "properties": {
    "schema": {
      "type": "string",
      "const": "wholeloop/frame-decision@1"
    },
    "by": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "type": "string",
      "enum": ["go", "on-hold", "dropped"]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "reopen": {
      "type": "string",
      "minLength": 1
    },
    "stopConditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
