{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wholeloop/evaluation-oracle@1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "const": "wholeloop/evaluation-oracle@1"
    },
    "scenario": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$",
      "maxLength": 64
    },
    "relevant": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,63}$",
        "maxLength": 64
      },
      "minItems": 1,
      "maxItems": 64
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$",
            "maxLength": 64
          },
          "kind": {
            "type": "string",
            "enum": ["cli", "http", "restart", "broker"]
          },
          "repository": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$",
            "maxLength": 64
          },
          "service": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$",
            "maxLength": 64
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 4096
            },
            "minItems": 0,
            "maxItems": 32
          },
          "exit": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "method": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "body": {
            "type": "string",
            "maxLength": 65536
          },
          "status": {
            "type": "string"
          },
          "httpStatus": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          },
          "json": {
            "type": "string",
            "maxLength": 65536
          },
          "stdout": {
            "type": "string",
            "maxLength": 65536
          },
          "stderr": {
            "type": "string",
            "maxLength": 65536
          },
          "data": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "maxLength": 4096
            }
          }
        },
        "required": ["id", "kind"]
      },
      "minItems": 1,
      "maxItems": 64
    }
  },
  "required": ["schema", "scenario", "relevant", "cases"]
}
