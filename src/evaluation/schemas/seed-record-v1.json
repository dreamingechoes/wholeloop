{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wholeloop/evaluation-seed-record@1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "const": "wholeloop/evaluation-seed-record@1"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "maxLength": 64
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "type": "string",
          "const": "wholeloop/evaluation-seed-request@1"
        },
        "catalog": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "maxLength": 64
        },
        "scenario": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$",
          "maxLength": 64
        },
        "variant": {
          "type": "string",
          "enum": ["baseline", "reference"]
        },
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$",
          "maxLength": 64
        }
      },
      "required": ["schema", "catalog", "scenario", "variant", "key"]
    },
    "license": {
      "type": "string",
      "const": "MIT"
    },
    "category": {
      "type": "string",
      "enum": ["regression", "persistence", "integration", "adversarial"]
    },
    "surfaces": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["cli", "api", "browser", "broker"]
      },
      "minItems": 1,
      "maxItems": 4
    },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$",
          "maxLength": 64
        },
        "category": {
          "type": "string",
          "enum": ["regression", "persistence", "integration", "adversarial"]
        },
        "surfaces": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["cli", "api", "browser", "broker"]
          },
          "minItems": 1,
          "maxItems": 4
        },
        "requirements": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ref": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_./-]{0,255}$",
              "maxLength": 256
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$",
              "maxLength": 64
            }
          },
          "required": ["ref", "sha256"]
        },
        "oracle": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ref": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_./-]{0,255}$",
              "maxLength": 256
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$",
              "maxLength": 64
            }
          },
          "required": ["ref", "sha256"]
        },
        "repositories": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$",
                "maxLength": 64
              },
              "baseline": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "ref": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_./-]{0,255}$",
                      "maxLength": 256
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$",
                      "maxLength": 64
                    },
                    "target": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_./-]{0,255}$",
                      "maxLength": 256
                    }
                  },
                  "required": ["ref", "sha256", "target"]
                },
                "minItems": 1,
                "maxItems": 64
              },
              "reference": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "ref": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_./-]{0,255}$",
                      "maxLength": 256
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$",
                      "maxLength": 64
                    },
                    "target": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_./-]{0,255}$",
                      "maxLength": 256
                    }
                  },
                  "required": ["ref", "sha256", "target"]
                },
                "minItems": 1,
                "maxItems": 64
              }
            },
            "required": ["id", "baseline", "reference"]
          },
          "minItems": 1,
          "maxItems": 16
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 120000
        }
      },
      "required": [
        "id",
        "category",
        "surfaces",
        "requirements",
        "oracle",
        "repositories",
        "timeoutMs"
      ]
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "maxLength": 64
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        }
      },
      "required": ["ref", "sha256", "bytes"]
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "maxLength": 64
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        }
      },
      "required": ["ref", "sha256", "bytes"]
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$",
            "maxLength": 64
          },
          "root": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "head": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "maxItems": 65,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "target": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$",
                  "maxLength": 64
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65536
                }
              },
              "required": ["target", "sha256", "bytes"]
            }
          }
        },
        "required": ["id", "root", "head", "files"]
      }
    },
    "execution": {
      "type": "string",
      "const": "git-seed-only"
    },
    "authority": {
      "type": "string",
      "const": "not-granted"
    },
    "nativeAcceptance": {
      "type": "string",
      "const": "not-established"
    },
    "seal": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "maxLength": 64
    }
  },
  "required": [
    "schema",
    "digest",
    "request",
    "license",
    "category",
    "surfaces",
    "definition",
    "requirements",
    "oracle",
    "repositories",
    "execution",
    "authority",
    "nativeAcceptance",
    "seal"
  ]
}
