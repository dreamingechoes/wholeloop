{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wholeloop/evaluation-catalog@1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "const": "wholeloop/evaluation-catalog@1"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "maxLength": 64
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$",
      "maxLength": 64
    },
    "license": {
      "type": "string",
      "const": "MIT"
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$",
            "maxLength": 64
          },
          "category": {
            "type": "string",
            "enum": ["regression", "persistence", "integration", "adversarial"]
          },
          "surfaces": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["cli", "api", "browser", "broker"]
            },
            "minItems": 1,
            "maxItems": 4
          },
          "requirements": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "maxLength": 64
          },
          "oracle": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "maxLength": 64
          },
          "repositories": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$",
              "maxLength": 64
            }
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 120000
          }
        },
        "required": [
          "id",
          "category",
          "surfaces",
          "requirements",
          "oracle",
          "repositories",
          "timeoutMs"
        ]
      }
    },
    "executed": {
      "type": "boolean",
      "const": false
    },
    "authority": {
      "type": "string",
      "const": "not-granted"
    }
  },
  "required": ["schema", "digest", "id", "license", "scenarios", "executed", "authority"]
}
