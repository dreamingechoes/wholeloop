{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wholeloop/evaluation-seed@1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "const": "wholeloop/evaluation-seed@1"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "maxLength": 64
    },
    "status": {
      "type": "string",
      "enum": ["ready", "unknown"]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "catalog": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "maxLength": 64
    },
    "scenario": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$",
      "maxLength": 64
    },
    "variant": {
      "type": "string",
      "enum": ["baseline", "reference"]
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$",
            "maxLength": 64
          },
          "root": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "head": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "seedFiles": {
            "type": "string",
            "enum": ["matching", "changed", "unavailable"]
          }
        },
        "required": ["id", "root"]
      }
    },
    "expected": {
      "type": "string",
      "const": "pinned"
    },
    "execution": {
      "type": "string",
      "const": "git-seed-only"
    },
    "authority": {
      "type": "string",
      "const": "not-granted"
    },
    "nativeAcceptance": {
      "type": "string",
      "const": "not-established"
    }
  },
  "required": [
    "schema",
    "digest",
    "status",
    "reason",
    "catalog",
    "scenario",
    "variant",
    "repositories",
    "expected",
    "execution",
    "authority",
    "nativeAcceptance"
  ]
}
