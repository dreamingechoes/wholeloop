{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wholeloop/evaluation-applications@1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "const": "wholeloop/evaluation-applications@1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$",
      "maxLength": 64
    },
    "license": {
      "type": "string",
      "const": "MIT"
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$",
            "maxLength": 64
          },
          "category": {
            "type": "string",
            "enum": ["regression", "persistence", "integration", "adversarial"]
          },
          "surfaces": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["cli", "api", "browser", "broker"]
            },
            "minItems": 1,
            "maxItems": 4
          },
          "requirements": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "ref": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_./-]{0,255}$",
                "maxLength": 256
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$",
                "maxLength": 64
              }
            },
            "required": ["ref", "sha256"]
          },
          "oracle": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "ref": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_./-]{0,255}$",
                "maxLength": 256
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$",
                "maxLength": 64
              }
            },
            "required": ["ref", "sha256"]
          },
          "repositories": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,63}$",
                  "maxLength": 64
                },
                "baseline": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "ref": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_./-]{0,255}$",
                        "maxLength": 256
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$",
                        "maxLength": 64
                      },
                      "target": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_./-]{0,255}$",
                        "maxLength": 256
                      }
                    },
                    "required": ["ref", "sha256", "target"]
                  },
                  "minItems": 1,
                  "maxItems": 64
                },
                "reference": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "ref": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_./-]{0,255}$",
                        "maxLength": 256
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$",
                        "maxLength": 64
                      },
                      "target": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_./-]{0,255}$",
                        "maxLength": 256
                      }
                    },
                    "required": ["ref", "sha256", "target"]
                  },
                  "minItems": 1,
                  "maxItems": 64
                }
              },
              "required": ["id", "baseline", "reference"]
            },
            "minItems": 1,
            "maxItems": 16
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 120000
          }
        },
        "required": [
          "id",
          "category",
          "surfaces",
          "requirements",
          "oracle",
          "repositories",
          "timeoutMs"
        ]
      },
      "minItems": 1,
      "maxItems": 64
    }
  },
  "required": ["schema", "id", "license", "scenarios"]
}
