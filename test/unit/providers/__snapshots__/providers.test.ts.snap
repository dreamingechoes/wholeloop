exports[`MCP rendering > antigravity http matches its golden configuration 1`] = `
{
  "applied": false,
  "destination": "$HOME/.gemini/config/mcp_config.json",
  "format": "json",
  "provider": "support",
  "schema": "wholeloop/mcp-add@1",
  "snippet": "{
  "mcpServers": {
    "support": {
      "serverUrl": "https://mcp.example.com/mcp"
    }
  }
}
",
  "target": "antigravity",
}
`;

exports[`MCP rendering > antigravity stdio matches its golden configuration 1`] = `
