    "skills": "rendered",
    "agents": "rendered",
    "hooks": "unimplemented",
    "readOnly": "inherited-parent-and-checked-headless",
    "engines": [
      "headless",
      "sequential"
    ]
  },
  "skills": [
    "wl-next"
  ],
  "agents": [
    "wl-reviewer"
  ],
