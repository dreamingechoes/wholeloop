exports[`additional tier-A render targets > copilot matches its native golden tree 1`] = `
{
  "bin/wl.mjs": {
    "content": "#!/usr/bin/env node
console.log("fixture core")
",
    "mode": 493,
  },
  "com.github.copilot/agents/wl-reviewer.agent.md": {
    "content": "---
name: wl-reviewer
description: Observe the assigned fixture.
tools:
  - view
  - glob
  - grep
  - web_fetch
include-custom-instructions: true
infer: false
---
The conductor supplies wholeloopRoot from the packaged adapter root command. For every canonical wl command invoke Node with wholeloopRoot/bin/wl.mjs. Read shared protocols under wholeloopRoot/resources/protocols/. If the root or required evidence is absent, return a question; do not guess PATH or manufacture coverage.

Canonical model tier: deep; inherit the selected session model. Read-only roles receive no shell or write tool; the conductor supplies observed command/provider results when needed.

# Review

Return concrete evidence.
<!-- wholeloop:entrypoint@1 -->
",
    "mode": 420,
  },
  "com.github.copilot/hooks/hooks.json": {
    "content": "{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "exec": "node",
        "args": [
          "-e",
          "const {join}=require('node:path');const {pathToFileURL}=require('node:url');const root=process.env.COPILOT_PLUGIN_ROOT;if(!root){process.stdout.write(JSON.stringify({permissionDecision:'deny',permissionDecisionReason:'wholeloop plugin root is unavailable.'}));}else{import(pathToFileURL(join(root,'hooks/run.mjs')).href).catch(()=>{process.stdout.write(JSON.stringify({permissionDecision:'deny',permissionDecisionReason:'wholeloop hook transport is unavailable.'}));});}",
          "copilot"
        ],
        "timeoutSec": 15
      }
    ]
  }
}
",
    "mode": 420,
  },
  "hooks/check.mjs": {
    "content": "import { spawnSync } from 'node:child_process'
import { fileURLToPath } from 'node:url'
export const unavailable={schema:'wholeloop/guard@1',decision:'deny',policies:['guard-unavailable'],reasons:['wholeloop guard is unavailable; inspect the configured external store and packaged core.']}
export function check(payload) {
 try {
  const input=JSON.stringify(payload)
  if(Buffer.byteLength(input)>2097152)return unavailable
  // A native client may run on Bun or ship its own executable as process.execPath.
  const result=spawnSync('node',[fileURLToPath(new URL('../bin/wl.mjs',import.meta.url)),'guard','before-tool','--stdin','--json'],{input,encoding:'utf8',timeout:5000,maxBuffer:65536,shell:false})
  if(result.error || ![0,2].includes(result.status))return unavailable
  const decision=JSON.parse(result.stdout)
  if(decision.schema!=='wholeloop/guard@1' || !['allow','deny'].includes(decision.decision) || result.status!==(decision.decision==='allow'?0:2) || !Array.isArray(decision.reasons))return unavailable
  return decision
 }catch{return unavailable}
}
",
    "mode": 420,
  },
  "hooks/run.mjs": {
    "content": "import { check, unavailable } from './check.mjs'
const target=process.argv.at(-1)
function emit(decision) {
 // Empty success preserves the client's normal permission checks; an allow would bypass them.
 if(decision.decision==='allow')return
 const reason=decision.reasons.join(' ')
 const output=target==='claude'?{hookSpecificOutput:{hookEventName:'PreToolUse',permissionDecision:'deny',permissionDecisionReason:reason}}:{permissionDecision:'deny',permissionDecisionReason:reason}
 process.stdout.write(JSON.stringify(output)+'\\n')
}
let bytes=0;const chunks=[]
const timer=setTimeout(()=>{emit(unavailable);process.exit(0)},5000)
try {
 for await(const chunk of process.stdin){bytes+=chunk.length;if(bytes>2097152)throw new Error('Input limit');chunks.push(chunk)}
 clearTimeout(timer)
 emit(check(JSON.parse(Buffer.concat(chunks).toString('utf8'))))
}catch{clearTimeout(timer);emit(unavailable)}
process.stdin.pause()
",
    "mode": 420,
  },
  "plugin.json": {
    "content": "{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "wholeloop",
  "version": "0.0.0",
  "description": "Define, build, roll out and learn through independent evidence-backed development steps.",
  "author": {
    "name": "Iván González Sáiz"
  },
  "license": "MIT",
  "homepage": "https://github.com/dreamingechoes/wholeloop",
  "repository": "https://github.com/dreamingechoes/wholeloop"
}
",
    "mode": 420,
  },
  "resources/protocols/core-invariants.md": {
    "content": "# Core invariants

Retain evidence.
",
    "mode": 420,
  },
  "skills/wl-next/SKILL.md": {
    "content": "---
name: wl-next
description: Continue fixture work.
---
Use the exact directory of this loaded SKILL.md reported by the client. If unavailable, ask for it. Its scripts/wl.mjs launcher imports the packaged core, even through an installed directory symlink. First call that launcher with adapter root --json and pass the returned root to delegated agents. Canonical wl commands below mean this launcher, never an unrelated executable on PATH.

# Next

Call wl next --json.
<!-- wholeloop:entrypoint@1 -->
