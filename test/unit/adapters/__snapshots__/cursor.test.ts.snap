bytes>2097152)throw new Error('\\\\''limit'\\\\'');chunks.push(chunk)}\\n  clearTimeout(timer)\\n  const payload=JSON.parse(Buffer.concat(chunks).toString('\\\\''utf8'\\\\''))\\n  \\n  if(!payload || typeof payload.cwd!=='\\\\''string'\\\\'' || !isAbsolute(payload.cwd) || typeof payload.tool_name!=='\\\\''string'\\\\'' || !payload.tool_input || typeof payload.tool_input!=='\\\\''object'\\\\'' || Array.isArray(payload.tool_input) || !Array.isArray(payload.workspace_roots) || !payload.workspace_roots.length || payload.workspace_roots.length>32)throw new Error('\\\\''context'\\\\'')\\n  const cwd=realpathSync(payload.cwd)\\n  const roots=payload.workspace_roots.map(root=>{if(typeof root!=='\\\\''string'\\\\'' || !isAbsolute(root))throw new Error('\\\\''workspace'\\\\'');return realpathSync(root)})\\n  if(!roots.some(root=>inside(root,cwd)))throw new Error('\\\\''cwd'\\\\'')\\n  const root=process.env.CURSOR_PLUGIN_ROOT\\n  if(typeof root!=='\\\\''string'\\\\'' || !isAbsolute(root))throw new Error('\\\\''root'\\\\'')\\n  const bin=matching(root)\\n\\n  if(!bin)throw new Error('\\\\''core'\\\\'')\\n  const result=spawnSync(process.execPath,[bin,'\\\\''guard'\\\\'','\\\\''before-tool'\\\\'','\\\\''--stdin'\\\\'','\\\\''--json'\\\\''],{cwd,input:JSON.stringify(payload),encoding:'\\\\''utf8'\\\\'',timeout:5000,killSignal:'\\\\''SIGKILL'\\\\'',maxBuffer:65536,shell:false})\\n  if(result.error || ![0,2].includes(result.status))throw new Error('\\\\''process'\\\\'')\\n  const value=JSON.parse(result.stdout)\\n  if(value.schema!=='\\\\''wholeloop/guard@1'\\\\'' || !['\\\\''allow'\\\\'','\\\\''deny'\\\\''].includes(value.decision) || result.status!==(value.decision==='\\\\''allow'\\\\''?0:2) || !Array.isArray(value.reasons) || value.reasons.some(reason=>typeof reason!=='\\\\''string'\\\\''))throw new Error('\\\\''result'\\\\'')\\n  emit(value.decision,value.decision==='\\\\''deny'\\\\''?value.reasons.join('\\\\'' '\\\\''):undefined)\\n }catch{deny()}finally{clearTimeout(timer);process.stdin.pause()}\\n})()\\n' || printf '%s\\\\n' '{\\"permission\\":\\"deny\\",\\"user_message\\":\\"wholeloop guard could not start.\\",\\"agent_message\\":\\"wholeloop guard could not start.\\"}'",
