{
  "name": "wholeloop",
  "version": "0.0.0",
  "description": "A CLI-agnostic AI development harness that closes the whole loop: define, build, roll out, learn.",
  "license": "MIT",
  "author": "Iván González Sáiz <hi@dreamingecho.es>",
  "homepage": "https://github.com/dreamingechoes/wholeloop#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dreamingechoes/wholeloop.git"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "wholeloop": "dist/wl.mjs",
    "wl": "dist/wl.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test && npm run lint:md"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "22.20.4",
    "esbuild": "0.28.2",
    "markdownlint-cli2": "0.23.3",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  },
  "overrides": {
    "katex": "0.18.9",
    "smol-toml": "1.9.0"
  }
}
