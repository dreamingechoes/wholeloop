{
  "name": "wholeloop",
  "version": "0.0.0",
  "description": "A CLI-agnostic AI development harness that closes the whole loop: define, build, roll out, learn.",
  "license": "MIT",
  "author": "Iv\u00e1n Gonz\u00e1lez S\u00e1iz <hi@dreamingecho.es>",
  "homepage": "https://github.com/dreamingechoes/wholeloop#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dreamingechoes/wholeloop.git"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "wholeloop": "dist/wl.mjs",
    "wl": "dist/wl.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "smoke": "node scripts/smoke.mjs",
    "package:check": "npm run build && node scripts/check-package.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "lint:md:fix": "markdownlint-cli2 \"**/*.md\" --fix",
    "lint:mermaid": "node scripts/check-mermaid.mjs",
    "docs:nav": "npm run build && node dist/wl.mjs docs nav",
    "docs:check": "node dist/wl.mjs docs check",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run build && npm run test && npm run smoke && node scripts/check-package.mjs && npm run commits:check && npm run docs:check && node scripts/generate-commands.mjs --check && node scripts/generate-config.mjs --check && node scripts/generate-providers.mjs --check && npm run harness:check && npm run lint:md && npm run lint:mermaid",
    "harness:check": "node dist/wl.mjs harness check",
    "docs:references": "npm run build && node dist/wl.mjs docs reference --write",
    "docs:providers": "npm run build && node dist/wl.mjs docs reference --kind providers --write",
    "docs:platforms": "npm run build && node dist/wl.mjs docs reference --kind platforms --write",
    "docs:commands": "npm run build && node scripts/generate-commands.mjs",
    "hooks:install": "npm run build && node scripts/install-hooks.mjs",
    "commits:check": "node scripts/check-commits.mjs",
    "docs:config": "npm run build && node scripts/generate-config.mjs",
    "providers:catalog": "node scripts/generate-providers.mjs",
    "eval:definitions": "npm run build && node dist/wl.mjs eval definitions test/evals/definition/corpus.json",
    "eval:gates": "npm run build && node dist/wl.mjs eval gates test/evals/gates/corpus.json --predictions test/evals/gates/baseline-predictions.json",
    "eval:grounding": "npm run build && node dist/wl.mjs eval grounding test/evals/grounding/corpus.json",
    "eval:environments": "node scripts/check-environments.mjs",
    "eval:behaviors": "node scripts/check-behaviors.mjs",
    "eval:browsers": "node scripts/check-browsers.mjs",
    "eval:private": "node scripts/check-private.mjs",
    "eval:integration": "node scripts/check-integration-candidates.mjs",
    "eval:assembly": "node scripts/check-assembly.mjs",
    "eval:delivery-fixtures": "node scripts/check-delivery-fixtures.mjs",
    "eval:delivery-browser": "node scripts/check-delivery-browser.mjs",
    "eval:decisions": "node scripts/check-decisions.mjs",
    "eval:runner-verification": "node scripts/check-runner-verification.mjs",
    "eval:runner-suites": "node scripts/check-runner-suites.mjs",
    "eval:runner-environment-phases": "node scripts/check-runner-environment-phases.mjs",
    "eval:runner-suite-continuation": "node scripts/check-runner-suite-continuation.mjs",
    "eval:runner-verification-continuation": "node scripts/check-runner-verification-continuation.mjs",
    "eval:runner-reverification": "node scripts/check-runner-reverification.mjs",
    "eval:runner-native-history": "node scripts/check-runner-native-history.mjs",
    "eval:runner-assembly-readiness": "node scripts/check-runner-assembly-readiness.mjs",
    "eval:runner-feature-readiness": "node scripts/check-runner-feature-readiness.mjs",
    "eval:runner-review": "node scripts/check-runner-review.mjs",
    "eval:runner-repairs": "node scripts/check-runner-repairs.mjs",
    "eval:runner-faults": "node scripts/check-runner-faults.mjs",
    "eval:runner-definitions": "node scripts/check-runner-definitions.mjs",
    "eval:runner": "node scripts/check-runner.mjs",
    "eval:native-boundary": "node scripts/check-native-boundary.mjs",
    "eval:claude-boundary": "node scripts/check-native-boundary.mjs claude",
    "eval:live-research": "npm run build && node scripts/check-live-research.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "22.20.4",
    "esbuild": "0.28.2",
    "github-slugger": "2.0.0",
    "jsdom": "30.1.1",
    "markdownlint-cli2": "0.23.3",
    "mermaid": "12.0.0",
    "smol-toml": "1.9.0",
    "typescript": "7.0.2",
    "vitest": "5.0.2",
    "yaml": "2.9.1"
  },
  "overrides": {
    "katex": "0.18.9",
    "lodash-es": "4.18.1",
    "smol-toml": "1.9.0"
  }
}
